(module
  (name "build.fs")
  (version "0.8.0-dev")
  (cap io unsafe-ffi)
  (export exists list_dir read_string sha256_hex write_bytes create_temp
          fsync_file rename fsync_dir mkdir_p remove env_string failpoint)

  ;; M3 文件系统包装（glue 原语；与 workflow 的 fs 包装是独立副本——
  ;; extern wrapper 重复本身是观察点，见 BUILD_OBSERVATIONS）
  (extern fs.exists
    (params (param path (prim string)))
    (returns (prim bool))
    (eff io)
    (unsafe)
    (rust "glue::fs_exists({path})"))

  (extern fs.list_dir
    (params (param path (prim string)))
    (returns (result (prim string) (prim string)))
    (eff io)
    (unsafe)
    (rust "glue::fs_list_dir({path})"))

  (extern fs.read_string
    (params (param path (prim string)))
    (returns (result (prim string) (prim string)))
    (eff io)
    (unsafe)
    (rust "glue::fs_read_string({path})"))

  (extern fs.sha256_hex
    (params (param data (prim bytes)))
    (returns (prim string))
    (pure)
    (unsafe)
    (rust "glue::fs_sha256({data})"))

  (extern fs.write_bytes
    (params (param path (prim string)) (param data (prim bytes)))
    (returns (result (prim i64) (prim string)))
    (eff io)
    (unsafe)
    (rust "glue::fs_write_bytes({path}, {data})"))

  (extern fs.create_temp
    (params (param dir (prim string)) (param prefix (prim string)))
    (returns (result (prim string) (prim string)))
    (eff io)
    (unsafe)
    (rust "glue::fs_create_temp({dir}, {prefix})"))

  (extern fs.fsync_file
    (params (param path (prim string)))
    (returns (result (prim i64) (prim string)))
    (eff io)
    (unsafe)
    (rust "glue::fs_fsync_file({path})"))

  (extern fs.rename
    (params (param src (prim string)) (param dst (prim string)))
    (returns (result (prim i64) (prim string)))
    (eff io)
    (unsafe)
    (rust "glue::fs_rename({src}, {dst})"))

  (extern fs.fsync_dir
    (params (param path (prim string)))
    (returns (result (prim i64) (prim string)))
    (eff io)
    (unsafe)
    (rust "glue::fs_fsync_dir({path})"))

  (extern fs.mkdir_p
    (params (param path (prim string)))
    (returns (result (prim i64) (prim string)))
    (eff io)
    (unsafe)
    (rust "glue::fs_mkdir_p({path})"))

  (extern fs.remove
    (params (param path (prim string)))
    (returns (result (prim i64) (prim string)))
    (eff io)
    (unsafe)
    (rust "glue::fs_remove({path})"))

  (extern fs.env_string
    (params (param name (prim string)) (param default (prim string)))
    (returns (prim string))
    (eff io)
    (unsafe)
    (rust "glue::fs_env_string({name}, {default})"))

  (extern fs.failpoint
    (params (param name (prim string)))
    (returns (prim i64))
    (eff io)
    (unsafe)
    (rust "glue::fs_failpoint({name})"))

  (fn exists
    (params (param path (prim string)))
    (returns (prim bool))
    (eff io)
    (body (call fs.exists (ref path))))

  (fn list_dir
    (params (param path (prim string)))
    (returns (result (prim string) (prim string)))
    (eff io)
    (body (call fs.list_dir (ref path))))

  (fn read_string
    (params (param path (prim string)))
    (returns (result (prim string) (prim string)))
    (eff io)
    (body (call fs.read_string (ref path))))

  (fn sha256_hex
    (params (param data (prim bytes)))
    (returns (prim string))
    (pure)
    (body (call fs.sha256_hex (ref data))))

  (fn write_bytes
    (params (param path (prim string)) (param data (prim bytes)))
    (returns (result (prim i64) (prim string)))
    (eff io)
    (body (call fs.write_bytes (ref path) (ref data))))

  (fn create_temp
    (params (param dir (prim string)) (param prefix (prim string)))
    (returns (result (prim string) (prim string)))
    (eff io)
    (body (call fs.create_temp (ref dir) (ref prefix))))

  (fn fsync_file
    (params (param path (prim string)))
    (returns (result (prim i64) (prim string)))
    (eff io)
    (body (call fs.fsync_file (ref path))))

  (fn rename
    (params (param src (prim string)) (param dst (prim string)))
    (returns (result (prim i64) (prim string)))
    (eff io)
    (body (call fs.rename (ref src) (ref dst))))

  (fn fsync_dir
    (params (param path (prim string)))
    (returns (result (prim i64) (prim string)))
    (eff io)
    (body (call fs.fsync_dir (ref path))))

  (fn mkdir_p
    (params (param path (prim string)))
    (returns (result (prim i64) (prim string)))
    (eff io)
    (body (call fs.mkdir_p (ref path))))

  (fn remove
    (params (param path (prim string)))
    (returns (result (prim i64) (prim string)))
    (eff io)
    (body (call fs.remove (ref path))))

  (fn env_string
    (params (param name (prim string)) (param default (prim string)))
    (returns (prim string))
    (eff io)
    (body (call fs.env_string (ref name) (ref default))))

  (fn failpoint
    (params (param name (prim string)))
    (returns (prim i64))
    (eff io)
    (body (call fs.failpoint (ref name))))
)
