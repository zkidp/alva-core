;; capture-distinct B: 内层 f == f（语义不同，hash 必须不同）
(module
  (name "qcapture")
  (version "0.1.0")
  (export pair_any)
  (fn pair_any
    (params (param xs (vec (prim i64))) (param ys (vec (prim i64))))
    (returns (prim bool))
    (pure)
    (pre (any e (ref xs) (any f (ref ys) (== (ref f) (ref f)))))
    (body (bool true))))
