        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "pre-registered src/**/*.alva path"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
