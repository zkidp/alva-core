        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "pre-registered src/**/*.alva path"
            },
            "content": {
              "type": "string",
              "description": "complete UTF-8 file content"
            }
          },
          "required": [
            "path",
            "content"
          ],
          "additionalProperties": false
        }
      }
    },
    {
