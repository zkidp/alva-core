(module
  (name "demo.model")
  (version "0.1.0")
  (export Meta make_meta size_of touch_size)

  (type Meta
    (record
      (field key (prim string))
      (field size (prim i64))))

  (fn make_meta
    (params
      (param key (prim string))
      (param size (prim i64)))
    (returns Meta)
    (pure)
    (body
      (record Meta
        (key (ref key))
        (size (ref size)))))

  (fn size_of
    (params
      (param m Meta))
    (returns (prim i64))
    (pure)
    (body
      (field (ref m) "size")))

  (fn touch_size
    (params
      (param m Meta))
    (returns Meta)
    (pure)
    (body
      (record Meta
        (key (field (ref m) "key"))
        (size (+ (field (ref m) "size") (int 1)))))))
