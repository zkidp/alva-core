(module
  (name "type_mismatch")
  (version "0.1.0")
  (cap io)
  (export main)
  (fn add
    (params
      (param a (prim i64))
      (param b (prim i64)))
    (returns (prim i64))
    (pure)
    (body (+ (ref a) (ref b))))
  (fn main
    (params)
    (returns (result (prim nil) (prim string)))
    (eff io)
    (body
      (call io.print (call add (int 1) (string "x")))
      (nil))))
