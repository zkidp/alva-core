(module
  (name "record_update_unknown_field")
  (version "0.1.0")
  (export bad)
  (type Item
    (record
      (field name (prim string))
      (field qty (prim i64))))
  (fn bad
    (params
      (param it Item))
    (returns Item)
    (pure)
    (body
      (record-update Item (ref it)
        (nope (int 1))))))
