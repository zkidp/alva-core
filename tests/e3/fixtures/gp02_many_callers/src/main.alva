(module
  (name "gp.main")
  (version "0.1.0")
  (export run run2 compute)

  (fn run
    (params)
    (returns (prim i64))
    (pure)
    (body
      (call add
        (call compute (int 1))
        (call compute (int 2)))))

  (fn run2
    (params)
    (returns (prim i64))
    (pure)
    (body
      (call compute (int 3))))

  (fn compute
    (params
      (param x (prim i64)))
    (returns (prim i64))
    (pure)
    (body
      (ref x)))

  (fn add
    (params
      (param x (prim i64))
      (param y (prim i64)))
    (returns (prim i64))
    (pure)
    (body
      (ref x)))
)
