(module
  (name "gp.main")
  (version "0.1.0")
  (export run compute)

  (fn run
    (params)
    (returns (prim i64))
    (pure)
    (body
      (call add
        (call compute (int 1))
        (call compute (int 2)))))

  (fn compute
    (params
      (param x (prim i64)))
    (returns (prim i64))
    (pure)
    (body
      (call add (ref x) (int 2))))

  (fn add
    (params
      (param x (prim i64))
      (param y (prim i64)))
    (returns (prim i64))
    (pure)
    (body
      (ref x)))
)
