(module
  (name "n08")
  (version "0.1.0")
  (export pair)

  (fn pair
    (params)
    (returns (prim i64))
    (pure)
    (body
      (call add
        (call left (int 3))
        (call right (int 5)))))

  (fn left
    (params
      (param x (prim i64)))
    (returns (prim i64))
    (pure)
    (body
      (ref x)))

  (fn right
    (params
      (param x (prim i64)))
    (returns (prim i64))
    (pure)
    (body
      (ref x)))

  (fn add
    (params
      (param a (prim i64))
      (param b (prim i64)))
    (returns (prim i64))
    (pure)
    (body
      (ref a)))
)
