(module
  (name "n06")
  (version "0.1.0")
  (export fee)

  (fn fee
    (params)
    (returns (prim i64))
    (pure)
    (body
      (call add
        (call id (int 10))
        (call id (int 5)))))

  (fn id
    (params
      (param x (prim i64)))
    (returns (prim i64))
    (pure)
    (body
      (ref x)))

  (fn add
    (params
      (param a (prim i64))
      (param b (prim i64)))
    (returns (prim i64))
    (pure)
    (body
      (ref a)))
)
