(module
  (name "m08")
  (version "0.1.0")
  (export pack greet farewell)

  (fn pack
    (params
      (param name (prim string)))
    (returns (prim string))
    (pure)
    (body
      (ref name)))

  (fn greet
    (params)
    (returns (prim string))
    (pure)
    (body
      (call pack (string "a"))))

  (fn farewell
    (params)
    (returns (prim string))
    (pure)
    (body
      (call pack (string "b"))))
)
