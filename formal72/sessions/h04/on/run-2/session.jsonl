{"type":"item.started","item":{"id":"item_463","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\nimport struct\npath='/usr/local/bin/alva'\ndata=open(path,'rb').read()\ntext_vaddr=0x8d800; text_off=0x8c800; text_size=0x24fc23\ntext=data[text_off:text_off+text_size]\ntargets={0x26a2f,0x26a47,0x26a52,0x24bc4}\n# scan for disp32 in any instruction: heuristic - find 4-byte little-endian d where d in [0x20000,0x30000]\n# then check candidates for rip-rel semantics is hard without decoding; instead find bytes patterns 8D 05/8D 3D etc with any REX prefix (including 66, 67)\nhits={t:[] for t in targets}\n# also try with 66 48 8d, 48 8d 85 with disp32 (modrm 0x85 = rbp+disp32 not rip) - no.\n# scan all possible 5-7 byte sequences: opcode 8D with modrm in 05..3D and optional 67/66/REX prefixes\ni=0\nwhile i < len(text)-6:\n    # try prefix combos: [67] [66] [REX] 8D modrm disp32\n    for plen in (0,1,2,3):\n        pre=text[i:i+plen]\n        if plen>0 and pre[0] not in (0x66,0x67,0x40,0x41,0x42,0x43,0x44,0x45,0x46,0x47,0x48,0x49,0x4a,0x4b,0x4c,0x4d,0x4e,0x4f):\n            break\n        if i+plen+6>len(text): break\n        if text[i+plen]==0x8d and text[i+plen+1] in (0x05,0x0d,0x15,0x1d,0x25,0x2d,0x35,0x3d):\n            disp=struct.unpack_from('<i', text, i+plen+2)[0]\n            insn_end=text_vaddr+i+plen+6\n            if insn_end+disp in targets:\n                hits[insn_end+disp].append(text_vaddr+i)\n    i+=1\nfor t,rs in hits.items():\n    print(hex(t), [hex(r) for r in rs[:20]])\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
