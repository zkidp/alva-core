{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/sh -lc \"ls -la /opt/alva/ && sed -n '1,200p' /opt/alva/aep.py\"","aggregated_output":"total 40\ndrwxr-xr-x    1 root     root          4096 Aug 12 16:32 .\ndrwxr-xr-x    1 root     root          4096 Aug 12 16:32 ..\n-rw-rw-r--    1 root     root          4085 Aug 12 16:32 AEP_TOOLS.md\n-rwxrwxr-x    1 root     root          5186 Aug 12 16:32 ac_client.py\n-rwxrwxr-x    1 root     root          2361 Aug 12 16:32 aep.py\n-rwxrwxr-x    1 root     root          1424 Aug 12 16:32 agent_entrypoint.sh\n-rwxrwxr-x    1 root     root          1467 Aug 12 16:32 isolation_self_test.sh\n#!/usr/bin/env python3\n\"\"\"AEP tool CLI for mode C pilots.\n\nThin wrapper over the ac_client.py gateway that takes key=value arguments\ninstead of a JSON string, so no shell quoting is needed:\n\n  python aep.py --port <port> begin_transaction project=C:\\\\path\\\\to\\\\alva.toml\n  python aep.py --port <port> create_literal type=string value=fsync_meta_dir\n  python aep.py --port <port> create_call name=step args=<literal_revision>\n  python aep.py --port <port> append_step function=store.commit.put_object step=<call_revision>\n  python aep.py --port <port> check_transaction\n  python aep.py --port <port> commit_transaction\n\nRepeatable keys:\n  args=...        -> list of call arguments (create_call)\n  params=...      -> flat list of parameter names (add_function; types default \"string\")\n\nSee AEP_TOOLS.md for the full tool list.\n\"\"\"\n\nimport argparse\nimport json\nimport socket\nimport sys\n\n\ndef call(port, request):\n    payload = (json.dumps(request, ensure_ascii=False) + \"\\n\").encode(\"utf-8\")\n    last = \"\"\n    for attempt in range(3):\n        try:\n            with socket.create_connection((\"127.0.0.1\", port), timeout=300) as s:\n                s.sendall(payload)\n                buf = b\"\"\n                while True:\n                    chunk = s.recv(1 << 20)\n                    if not chunk:\n                        break\n                    buf += chunk\n                    if buf.endswith(b\"\\n\"):\n                        break\n            last = buf.decode(\"utf-8\").strip()\n            if last:\n                break\n        except OSError:\n            last = \"\"\n        if not last and attempt < 2:\n            import time\n            time.sleep(0.5)\n    print(last or '{\"ok\":false,\"result\":null,\"message\":\"empty gateway response\"}')\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__)\n    ap.add_argument(\"--port\", type=int, required=True)\n    ap.add_argument(\"tool\")\n    ap.add_argument(\"kv\", nargs=\"*\", help=\"key=value arguments\")\n    args = ap.parse_args()\n    req = {\"tool\": args.tool}\n    for item in args.kv:\n        if \"=\" not in item:\n            sys.exit(\"expected key=value, got: \" + item)\n        k, v = item.split(\"=\", 1)\n        if k in (\"args\", \"params\"):\n            req.setdefault(k, []).append(v)\n        else:\n            req[k] = v\n    call(args.port, req)\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","exit_code":0,"status":"completed"}}
