ction((\\\"127.0.0.1\\\", port), timeout=30) as s:\n    s.sendall((json.dumps({\\\"tool\\\":\\\"begin_transaction\\\",\\\"project\\\":\\\"/workspace/alva.toml\\\"})+\\\"\\\\n\\\").encode())\n    buf=b\\\"\\\"\n    while True:\n        ch=s.recv(1<<20)\n        if not ch: break\n        buf+=ch\n        if buf.endswith(b\\\"\\\\n\\\"): break\nfor n in names:\n    with socket.create_connection((\\\"127.0.0.1\\\", port), timeout=20) as s:\n        s.sendall((json.dumps({\\\"tool\\\":\\\"describe_operation\\\",\\\"name\\\":n})+\\\"\\\\n\\\").encode())\n        buf=b\\\"\\\"\n        while True:\n            ch=s.recv(1<<20)\n            if not ch: break\n            buf+=ch\n            if buf.endswith(b\\\"\\\\n\\\"): break\n    d=json.loads(buf.decode().strip())\n    if d.get(\\\"ok\\\"):\n        print(\\\"FOUND:\\\", n, json.dumps(d.get(\\\"result\\\",{}).get(\\\"arguments\\\")))\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
