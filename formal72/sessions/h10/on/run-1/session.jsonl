{"type":"item.started","item":{"id":"item_561","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\nimport socket, json\nport = 41471\n# Send a raw tool request to see if the gateway accepts a 'kind' field on create_call to make ok/err nodes\nwith socket.create_connection((\\\"127.0.0.1\\\", port), timeout=30) as s:\n    s.sendall((json.dumps({\\\"tool\\\":\\\"begin_transaction\\\",\\\"project\\\":\\\"/workspace/alva.toml\\\"})+\\\"\\\\n\\\").encode())\n    buf=b\\\"\\\"\n    while True:\n        ch=s.recv(1<<20)\n        if not ch: break\n        buf+=ch\n        if buf.endswith(b\\\"\\\\n\\\"): break\n    print(buf.decode().strip())\ntests = [\n    {\\\"tool\\\":\\\"create_call\\\",\\\"name\\\":\\\"err\\\",\\\"kind\\\":\\\"err\\\",\\\"args\\\":[\\\"222cd70da0d48930408b0d8bca0b8d20a8a3f90a7cb6fa580bd9db0e64757840\\\"]},\n    {\\\"tool\\\":\\\"create_call\\\",\\\"name\\\":\\\"ok\\\",\\\"kind\\\":\\\"ok\\\",\\\"args\\\":[\\\"222cd70da0d48930408b0d8bca0b8d20a8a3f90a7cb6fa580bd9db0e64757840\\\"]},\n    {\\\"tool\\\":\\\"create_call\\\",\\\"name\\\":\\\"err\\\",\\\"kind\\\":\\\"expr\\\",\\\"value\\\":\\\"222cd70da0d48930408b0d8bca0b8d20a8a3f90a7cb6fa580bd9db0e64757840\\\"},\n    {\\\"tool\\\":\\\"create_call\\\",\\\"name\\\":\\\"err\\\",\\\"type\\\":\\\"tagged\\\",\\\"args\\\":[\\\"222cd70da0d48930408b0d8bca0b8d20a8a3f90a7cb6fa580bd9db0e64757840\\\"]},\n    {\\\"tool\\\":\\\"create_call\\\",\\\"name\\\":\\\"err\\\",\\\"slot\\\":\\\"value\\\",\\\"args\\\":[\\\"222cd70da0d48930408b0d8bca0b8d20a8a3f90a7cb6fa580bd9db0e64757840\\\"]},\n    {\\\"tool\\\":\\\"create_expression\\\",\\\"kind\\\":\\\"err\\\",\\\"value\\\":\\\"222cd70da0d48930408b0d8bca0b8d20a8a3f90a7cb6fa580bd9db0e64757840\\\"},\n    {\\\"tool\\\":\\\"create_tagged\\\",\\\"kind\\\":\\\"err\\\",\\\"value\\\":\\\"222cd70da0d48930408b0d8bca0b8d20a8a3f90a7cb6fa580bd9db0e64757840\\\"},\n    {\\\"tool\\\":\\\"create_constructor\\\",\\\"kind\\\":\\\"err\\\",\\\"value\\\":\\\"222cd70da0d48930408b0d8bca0