{"type":"item.completed","item":{"id":"item_120","type":"command_execution","command":"/bin/sh -lc 'cat /opt/alva/agent_entrypoint.sh; echo ----; cat /opt/alva/isolation_self_test.sh; echo ----; cat /opt/alva/ac_client.py'","aggregated_output":"#!/usr/bin/env bash\nset -euo pipefail\n# Container entrypoint: run the isolation self-test, then the agent.\n/opt/alva/isolation_self_test.sh\nARGS=(-C /workspace -s workspace-write --skip-git-repo-check\n  --ephemeral --json\n  -c \"model_provider=${ALVA_PROVIDER:-deepseek}\"\n  -c preferred_auth_method=apikey\n  -c forced_login_method=api\n  -m \"${CODEX_MODEL:-deepseek-v4-flash}\")\n# The container itself is the isolation boundary (no repo mount, relay-only\n# network), so codex's internal bwrap sandbox is redundant and unavailable\n# here; bypass it inside the container only.\nARGS+=(--dangerously-bypass-approvals-and-sandbox)\n\nif [ \"${MODE:-A}\" = \"C\" ]; then\n  # Start the AEP gateway inside the container (localhost only), then let the\n  # agent reach it at 127.0.0.1:<port from /workspace/port.txt>.\n  /opt/alva/ac_client.py serve \\\n    --alva /usr/local/bin/alva \\\n    --project /workspace/alva.toml \\\n    --port 0 --state /workspace &\n  for _ in $(seq 1 100); do\n    [ -f /workspace/port.txt ] && break\n    sleep 0.1\n  done\n  if [ ! -f /workspace/port.txt ]; then\n    echo \"FATAL: AEP gateway failed to start (no /workspace/port.txt)\" >&2\n    exit 1\n  fi\nfi\n\nif [ -f /workspace/prompt.txt ]; then\n  # Robust path: read the prompt from a file via stdin (avoids any\n  # multi-layer shell quoting of multi-word prompts).\n  cat /workspace/prompt.txt | exec codex exec \"${ARGS[@]}\" -\nelse\n  exec codex exec \"${ARGS[@]}\" \"$@\"\nfi\n----\n#!/usr/bin/env bash\nset -euo pipefail\nFAIL=0\n\ncheck_fail_read() {\n  if [ -r \"$1\" ]; then\n    echo \"FAIL: $1 is readable (must NOT be mounted)\"\n    FAIL=1\n  else\n    echo \"PASS: $1 not readable\"\n  fi\n}\n\ncheck_fail_write() {\n  if touch \"$1\" 2>/dev/null; then\n    echo \"FAIL: $1 is writable (must be read-only outside /workspace)\"\n    FAIL=1\n  else\n    echo \"PASS: $1 not writable\"\n  fi\n}\n\n# 1. held-out verifier / host secrets must not be mounted\ncheck_fail_read /host-secrets/marker\ncheck_fail_read /repo\n# 2. no repository mount\nif [ -d /repo ]; then\n  echo \"FAIL: /repo is present\"\n  FAIL=1\nelse\n  echo \"PASS: no /repo mount\"\nfi\n# 3. network: relay reachable, non-relay blocked (relay-only policy)\nRELAY=\"${MODEL_RELAY:-https://api.deepseek.com}\"\nRELAY_CODE=\"$(curl -s -m 8 -o /dev/null -w '%{http_code}' \"$RELAY\" 2>/dev/null || true)\"\nif [ -n \"$RELAY_CODE\" ] && [ \"$RELAY_CODE\" != \"000\" ]; then\n  echo \"PASS: relay reachable\"\nelse\n  echo \"FAIL: relay unreachable (http_code=$RELAY_CODE)\"\n  FAIL=1\nfi\nif curl -fsS -m 8 -o /dev/null https://example.com 2>/dev/null; then\n  echo \"FAIL: non-relay host reachable (network not relay-only)\"\n  FAIL=1\nelse\n  echo \"PASS: non-relay host blocked\"\nfi\n# 4. workspace writable, root read-only\nif touch /workspace/.probe 2>/dev/null && rm /workspace/.probe; then\n  echo \"PASS: /workspace writable\"\nelse\n  echo \"FAIL: /workspace not writable\"\n  FAIL=1\nfi\ncheck_fail_write /root/.probe\ncheck_fail_write /opt/alva/.probe\n\nexit $FAIL\n----\n#!/usr/bin/env python3\n\"\"\"AEP tool gateway for mode C pilot runs.\n\nThe Agent Runtime (`alva agent`) is a persistent stdin/stdout session. This\ngateway keeps that session alive in a background process and exposes one-shot\ntool calls over a local TCP socket, so an external agent can call AEP tools\none at a time:\n\n  python ac_client.py serve --alva <exe> --project <toml> --port <n> --state <dir>\n      spawns `alva agent`, listens on 127.0.0.1:<n>, writes the actual port to\n      <dir>/port.txt (use --port 0 to pick a free port)\n  python ac_client.py call --port <n> --request '<json>'\n      sends one tool request, prints the response JSON on one line\n  python ac_client.py stop --port <n>\n      tells the server to terminate the agent session and exit\n\nEvery call is a full AEP request: {\"request_id\": \"...\", \"tool\": \"...\", ...}.\n\"\"\"\n\nimport argparse\nimport json\nimport os\nimport socket\nimport subprocess\nimport sys\nimport threading\nimport time\n\n\ndef serve(alva, project, port, state_dir):\n    agent = subprocess.Popen(\n        [alva, \"agent\"],\n        stdin=subprocess.PIPE,\n        stdout=subprocess.PIPE,\n        text=True,\n        bufsize=1,\n    )\n    lock = threading.Lock()\n    stopped = {\"v\": False}\n\n    def read_response():\n        line = agent.stdout.readline()\n        if not line:\n            return None\n        return line.strip()\n\n    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\n    srv.bind((\"127.0.0.1\", port))\n    srv.listen(16)\n    actual_port = srv.getsockname()[1]\n    os.makedirs(state_dir, exist_ok=True)\n    with open(os.path.join(state_dir, \"port.txt\"), \"w\", encoding=\"utf-8\") as fh:\n        fh.write(str(actual_port) + \"\\n\")\n    with open(os.path.join(state_dir, \"pid.txt\"), \"w\", encoding=\"utf-8\") as fh:\n        fh.write(str(os.getpid()) + \"\\n\")\n\n    def serve_loop():\n        while not stopped[\"v\"]:\n            try:\n                conn, _ = srv.accept()\n            except OSError:\n                break\n            with conn:\n                data = b\"\"\n                while True:\n                    chunk = conn.recv(1 << 20)\n                    if not chunk:\n                        break\n                    data += chunk\n                    if data.endswith(b\"\\n\"):\n                        break\n                if not data:\n                    continue\n                req = data.decode(\"utf-8\").strip()\n                if req == '{\"control\":\"stop\"}':\n                    stopped[\"v\"] = True\n                    conn.sendall(b'{\"control\":\"stopped\"}\\n')\n                    break\n                with lock:\n                    agent.stdin.write(req + \"\\n\")\n                    agent.stdin.flush()\n                    resp = read_response()\n                if resp is None:\n                    resp = json.dumps(\n                        {\"ok\": False, \"result\": \"null\",\n                         \"message\": \"agent process exited unexpectedly\"}\n                    )\n                conn.sendall((resp + \"\\n\").encode(\"utf-8\"))\n        srv.close()\n\n    th = threading.Thread(target=serve_loop, daemon=True)\n    th.start()\n    try:\n        while th.is_alive():\n            time.sleep(0.2)\n    except KeyboardInterrupt:\n        pass\n    stopped[\"v\"] = True\n    try:\n        srv.close()\n    except OSError:\n        pass\n    try:\n        agent.stdin.close()\n    except Exception:\n        pass\n    try:\n        agent.terminate()\n    except Exception:\n        pass\n    try:\n        agent.wait(timeout=5)\n    except Exception:\n        agent.kill()\n    return 0\n\n\ndef call(port, request):\n    payload = (request if request.endswith(\"\\n\") else request + \"\\n\").encode(\"utf-8\")\n    with socket.create_connection((\"127.0.0.1\", port), timeout=120) as s:\n        s.sendall(payload)\n        buf = b\"\"\n        while True:\n            chunk = s.recv(1 << 20)\n            if not chunk:\n                break\n            buf += chunk\n            if buf.endswith(b\"\\n\"):\n                break\n    print(buf.decode(\"utf-8\").strip())\n    return 0\n\n\ndef stop(port):\n    try:\n        with socket.create_connection((\"127.0.0.1\", port), timeout=10) as s:\n            s.sendall(b'{\"control\":\"stop\"}\\n')\n            s.recv(1024)\n    except OSError:\n        pass\n    return 0\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__)\n    sub = ap.add_subparsers(dest=\"cmd\", required=True)\n    p_serve = sub.add_parser(\"serve\")\n    p_serve.add_argument(\"--alva\", required=True)\n    p_serve.add_argument(\"--project\", required=True)\n    p_serve.add_argument(\"--port\", type=int, default=0)\n    p_serve.add_argument(\"--state\", required=True)\n    p_call = sub.add_parser(\"call\")\n    p_call.add_argument(\"--port\", type=int, required=True)\n    p_call.add_argument(\"--request\", required=True)\n    p_stop = sub.add_parser(\"stop\")\n    p_stop.add_argument(\"--port\", type=int, required=True)\n    args = ap.parse_args()\n    if args.cmd == \"serve\":\n        return serve(args.alva, args.project, args.port, args.state)\n    if args.cmd == \"call\":\n        return call(args.port, args.request)\n    if args.cmd == \"stop\":\n        return stop(args.port)\n    return 2\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","exit_code":0,"status":"completed"}}
