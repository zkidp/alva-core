{"type":"item.started","item":{"id":"item_279","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'PY'\nimport subprocess, json, sys, re\nPORT = 45225\n\ndef aep(tool, kvs):\n    args = [\\\"python3\\\", \\\"/opt/alva/aep.py\\\", \\\"--port\\\", str(PORT), tool]\n    for k, v in kvs:\n        args.append(f\\\"{k}={v}\\\")\n    r = json.loads(subprocess.check_output(args, text=True))\n    if not r.get('ok'):\n        print(f\\\"FAIL {tool} {kvs}\\\\n{r}\\\")\n        sys.exit(1)\n    return r\n\ndef ent(rev):\n    return aep('inspect_entity', [('entity', rev)])['result']\n\ndef body_block_rev(fn):\n    body = aep('inspect_body', [('function', fn)])['result']['body']\n    return re.search(r'block rev=([0-9a-f]{64})', body).group(1)\n\ndef load_revs():\n    block = body_block_rev('h08.snapshot.load')\n    b_text = ent(block)['slots']['steps'][0]\n    b_lines = ent(b_text)['slots']['body'][0]\n    b_found = ent(b_lines)['slots']['body'][0]\n    fold = ent(b_found)['slots']['value'][0]\n    i1 = ent(b_found)['slots']['body'][0]\n    o1 = ent(i1)['slots']['then'][0]\n    e2 = ent(i1)['slots']['else'][0]\n    e1 = ent(fold)['slots']['acc_init'][0]\n    br = ent(fold)['slots']['body'][0]\n    ib = ent(br)['slots']['body'][0]\n    o2 = ent(ib)['slots']['then'][0]\n    return dict(block=block, b_text=b_text, b_lines=b_lines, b_found=b_found,\n                fold=fold, i1=i1, o1=o1, e2=e2, e1=e1, br=br, ib=ib, o2=o2)\n\naep('abort_transaction', [])\naep('begin_transaction', [('project','/workspace/alva.toml')])\n\nL = load_revs()\nprint('initial load revs:', {k: v[:8] for k, v in L.items()})\n\n# shared refs / literals\nREF_PAYLOAD = 'c9cc189e272de011e766c116fd4a79556bccb125243e4ca56b79ec056f409a9c'\nREF_LN = '3d62a2e3d6a49f1a6f9e6259a17c45745b9d72b83bfcec855a2a155f2701ae00'\nREF_LINES = 'effbe030da9f01dfc8ed176c561dad0507dff4c5a376ed9db4692382e0137c62'\nREF_I = 'bd046f189351d7f85d181e5a3ea3f0c20ad286bffc61aa13249b191ed3541ed2'\nREF_OUT = '5e2fc28b71b97f1dc3419ef