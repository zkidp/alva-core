{"type":"item.started","item":{"id":"item_444","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\nimport re\ndata=open('/usr/local/bin/alva','rb').read()\n# The dispatcher compares against byte strings; the full tool names are split across the binary.\n# Let's find the exact sequence of bytes around each fragment to reconstruct the full names.\n# Print 40 bytes around each fragment as hex+ascii\nfor off in [0xf32bc,0xf38ae,0xf38b9,0xf3a9a,0xf3ac3,0xf3aec,0xf3b1f,0xf3b55,0xf3b82,0xf3b93,0xf3bbe,0xf3bcf,0xf3be9,0xf3bfa,0xf3c14,0xf3c25,0xf3c3f,0xf3c50,0xf3c71,0xf3c8b,0xf3cb6,0xf3cc7,0xf3ceb,0xf3cfc,0xf3d1d,0xf3d2e,0xf3d59,0xf3d6a,0xf3d8b,0xf3d98,0xf3dbe,0xf3dd0,0xf3df0,0xf3e02,0xf3e2c,0xf3e3e,0xf3e5e,0xf3e6f]:\n    chunk=data[off-8:off+24]\n    hexs=' '.join('%02x'%c for c in chunk)\n    asci=''.join(chr(c) if 32<=c<127 else '.' for c in chunk)\n    print(hex(off), hexs, '|', asci)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
