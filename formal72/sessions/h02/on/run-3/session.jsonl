{"type":"item.started","item":{"id":"item_312","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\nimport struct\np = '/workspace/alva-air/h02_batch.air'\nwith open(p, 'rb') as f:\n    data = f.read()\n\ndef read_str(d, pos):\n    (n,) = struct.unpack_from('<I', d, pos); pos += 4\n    return d[pos:pos+n].decode('utf-8', 'replace'), pos + n\n\ndef read_val(d, pos):\n    tag = d[pos]; pos += 1\n    if tag == 1:\n        (n,) = struct.unpack_from('<I', d, pos); pos += 4\n        return d[pos:pos+n], pos + n\n    else:\n        (n,) = struct.unpack_from('<I', d, pos); pos += 4\n        return d[pos:pos+n], pos + n\n\ni = 0\nnodes = []\nwhile i < len(data):\n    if data[i:i+9] \"'!= b'\"'ALVANODE1':\n        i += 1\n        continue\n    pos = i + 9\n    kind, pos = read_str(data, pos)\n    (nfields,) = struct.unpack_from('<I', data, pos); pos += 4\n    fields = []\n    for _ in range(nfields):\n        fname, pos = read_str(data, pos)\n        val, pos = read_val(data, pos)\n        fields.append((fname, val))\n    (nslots,) = struct.unpack_from('<I', data, pos); pos += 4\n    slots = []\n    for _ in range(nslots):\n        sname, pos = read_str(data, pos)\n        val, pos = read_val(data, pos)\n        slots.append((sname, val))\n    # capture entity id if present in field \\\"entity\\\" or a trailing marker\n    nodes.append((kind, fields, slots))\n    i = pos\n\n# For result type_expr nodes, print fields + slot child hashes\nfor idx, (kind, fields, slots) in enumerate(nodes):\n    if kind == 'type_expr':\n        fdict = dict(fields)\n        if fdict.get('shape') == b'result':\n            print(f\\\"node[{idx}] fields={ {k:v.decode('latin1') for k,v in fields} } slots={ {k:v.hex() for k,v in slots} }\\\")\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
