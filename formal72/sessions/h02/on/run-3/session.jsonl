{"type":"item.started","item":{"id":"item_470","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\nimport struct\nwith open('/workspace/alva-air/h02_batch.air', 'rb') as f:\n    data = f.read()\n\ndef read_str(d, pos):\n    (n,) = struct.unpack_from('<I', d, pos); pos += 4\n    return d[pos:pos+n].decode('utf-8', 'replace'), pos + n\n\ndef read_val(d, pos):\n    tag = d[pos]; pos += 1\n    (n,) = struct.unpack_from('<I', d, pos); pos += 4\n    return d[pos:pos+n], pos + n\n\npos = 0\nnodes = []\nwhile True:\n    m = data.find(b'ALVANODE1', pos)\n    if m < 0:\n        break\n    pos = m + 9\n    kind, pos = read_str(data, pos)\n    (nfields,) = struct.unpack_from('<I', data, pos); pos += 4\n    fields = []\n    for _ in range(nfields):\n        fname, pos = read_str(data, pos)\n        val, pos = read_val(data, pos)\n        fields.append((fname, val))\n    (nslots,) = struct.unpack_from('<I', data, pos); pos += 4\n    slots = []\n    for _ in range(nslots):\n        sname, pos = read_str(data, pos)\n        val, pos = read_val(data, pos)\n        slots.append((sname, val))\n    (eidlen,) = struct.unpack_from('<I', data, pos); pos += 4\n    eid = data[pos:pos+eidlen]; pos += eidlen\n    nodes.append((kind, fields, slots, eid))\n    if pos >= len(data):\n        break\nprint(\\\"parsed nodes:\\\", len(nodes))\n# find type_expr nodes with shape result and their child hashes\nfor idx, (kind, fields, slots, eid) in enumerate(nodes):\n    if kind == 'type_expr':\n        fdict = {k.decode('latin1'): v.decode('latin1', 'replace') for k, v in fields}\n        if fdict.get('shape') == 'result':\n            print(f\\\"[{idx}] eid={eid} shape=result slots={ {k.decode(): v.hex()[:16] for k,v in slots} }\\\")\n# find the nil type_expr\nfor idx, (kind, fields, slots, eid) in enumerate(nodes):\n    if kind == 'type_expr':\n        fdict = {k.decode('latin1'): v.decode('latin1', 'replace') for k, v in fields}\n        if fdict.get('name') == 'nil':\n            print(f\\\"[{idx}] nil eid={eid}\\\")\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
