{"type":"item.started","item":{"id":"item_328","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\nimport struct\nwith open('/workspace/alva-air/h02_batch.air', 'rb') as f:\n    data = f.read()\n\ndef read_str(d, pos):\n    (n,) = struct.unpack_from('<I', d, pos); pos += 4\n    return d[pos:pos+n].decode('utf-8', 'replace'), pos + n\n\ndef read_field_val(d, pos):\n    tag = d[pos]; pos += 1\n    (n,) = struct.unpack_from('<I', d, pos); pos += 4\n    return d[pos:pos+n], pos + n\n\npos = 0\nnodes = []\nwhile pos < len(data):\n    m = data.find(b'ALVANODE1', pos)\n    if m < 0:\n        break\n    pos = m + 9\n    kind, pos = read_str(data, pos)\n    (nfields,) = struct.unpack_from('<I', data, pos); pos += 4\n    fields = []\n    for _ in range(nfields):\n        fname, pos = read_str(data, pos)\n        val, pos = read_field_val(data, pos)\n        fields.append((fname, val))\n    (nslots,) = struct.unpack_from('<I', data, pos); pos += 4\n    slots = []\n    for _ in range(nslots):\n        sname, pos = read_str(data, pos)\n        # read slot value: flexible parse - dump bytes for later analysis\n        start = pos\n        # try: 1-byte tag + u32 len + payload\n        tag = data[pos]\n        if tag == 1 and pos + 5 <= len(data):\n            (n,) = struct.unpack_from('<I', data, pos+1)\n            if pos + 5 + n <= len(data) and n <= 100000:\n                val = data[pos+5:pos+5+n]\n                pos = pos + 5 + n\n                slots.append((sname, val, 'tagged'))\n                continue\n        # try: 1-byte tag + 32-byte ref\n        if pos + 33 <= len(data):\n            val = data[pos+1:pos+33]\n            pos = pos + 33\n            slots.append((sname, val, 'ref'))\n            continue\n        print(\\\"FAILED slot parse at\\\", pos, \\\"kind\\\", kind, \\\"slot\\\", sname)\n        raise SystemExit\n    # node id: 32 bytes\n    nodeid = data[pos:pos+32]; pos += 32\n    nodes.append((kind, fields, slots, nodeid))\nprint(\\\"nodes:\\\", len(nodes))\ncnt = 0\nfor idx, (kind, fields, slots, nodeid) in enumerate(nodes):\n    if kind == 'type_expr':\n        fdict = {k.decode('latin1'): v.decode('latin1', 'replace') for k, v in fields}\n        if fdict.get('shape') == 'result':\n            cnt += 1\n            sdict = {k.decode(): v.hex() for k, v, _ in slots}\n            print(f\\\"RESULT[{idx}] id={nodeid.hex()} fields={fdict} slots={sdict}\\\")\nprint(\\\"result count:\\\", cnt)\n# sample a few slot forms\nfrom collections import Counter\nforms = Counter()\nfor idx, (kind, fields, slots, nodeid) in enumerate(nodes):\n    for sname, sval, form in slots:\n        forms[(kind, sname, form)] += 1\nfor k, v in sorted(forms.items()):\n    print(k, v)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
