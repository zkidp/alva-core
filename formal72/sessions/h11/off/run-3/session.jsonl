{"type":"item.started","item":{"id":"item_305","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\nimport struct\ndata=open('/workspace/alva-air/h11_dispatch.air','rb').read()\n# decode the 'field' nodes and their slots to understand structure\ndef read_str(data,p):\n    (ln,)=struct.unpack('<I', data[p:p+4]); p+=4\n    return data[p:p+ln].decode(), p+ln\nidx=0\nwhile True:\n    i=data.find(b'ALVANODE1', idx)\n    if i<0: break\n    p=i+9\n    (ln,)=struct.unpack('<I', data[p:p+4]); p+=4\n    kind=data[p:p+ln].decode(); p+=ln\n    # node header: after kind, 4-byte len, then fields map\n    (hdr,)=struct.unpack('<I', data[p:p+4]); p+=4\n    # fields count\n    (fc,)=struct.unpack('<I', data[p:p+4]); p+=4\n    fields={}\n    for _ in range(fc):\n        (fl,)=struct.unpack('<I', data[p:p+4]); p+=4\n        fname=data[p:p+fl].decode(); p+=fl\n        # value: 4-byte type tag? observed: 01 for string, 05 for vec?\n        (vt,)=struct.unpack('<I', data[p:p+4]); p+=4\n        if vt==1:\n            (vl,)=struct.unpack('<I', data[p:p+4]); p+=4\n            val=data[p:p+vl].decode(); p+=vl\n            fields[fname]=('str',val)\n        else:\n            # likely vec of revisions\n            (cl,)=struct.unpack('<I', data[p:p+4]); p+=4\n            revs=[]\n            for _ in range(cl):\n                (rl,)=struct.unpack('<I', data[p:p+4]); p+=4\n                rev=data[p:p+rl].hex(); p+=rl\n                revs.append(rev[:16])\n            fields[fname]=('vec',revs)\n    if kind=='field':\n        print(\\\"FIELD\\\", i, fields)\n    idx=i+9\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
