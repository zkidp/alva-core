{"type":"item.started","item":{"id":"item_254","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\nfrom dataclasses import dataclass\n@dataclass\nclass C:\n    id:str; zone:str; score:int; seq:int; active:bool\n@dataclass\nclass S:\n    out:list; inserted:bool\n\n# Attempt: better returns True when item should be placed BEFORE cur in final order\n# AND ALSO when item is a same-id improvement (to trigger replacement via insert-before)\n# We keep insert_one UNCHANGED and only change better. See what dedup looks like.\ndef better(a,b):\n    if a.id==b.id:\n        # same id: is a strictly better than b? (score desc, seq asc)\n        if a.score\"'!=b.score: return a.score>b.score\n        return a.seq<b.seq\n    # different ids: ordering (score desc, seq asc)\n    if a.score!=b.score: return a.score>b.score\n    return a.seq<b.seq\n\ndef insert_one(st,item):\n    n=len(st.out); acc=S([],False)\n    for i in range(n):\n        cur=st.out[i]\n        if acc.inserted:\n            acc=S(acc.out+[cur],True)\n        else:\n            if better(item,cur):\n                acc=S(acc.out+[item,cur],True)\n            else:\n                acc=S(acc.out+[cur],False)\n    return acc if acc.inserted else S(acc.out+[item],False)\n\ndef sort_by_score(items):\n    st=S([],False)\n    for it in items: st=insert_one(st,it)\n    return st.out\n\ncases=[\n [C(\"a\",\"n\",5,1,True),C(\"a\",\"s\",3,2,True),C(\"b\",\"e\",7,3,True)],\n [C(\"a\",\"n\",3,1,True),C(\"a\",\"s\",5,2,True)],\n [C(\"a\",\"n\",5,2,True),C(\"a\",\"s\",5,1,True)],\n [C(\"a\",\"n\",5,1,True),C(\"b\",\"s\",5,2,True),C(\"a\",\"e\",5,1,True)],\n [C(\"a\",\"n\",5,2,True),C(\"b\",\"s\",5,1,True)],\n]\nfor items in cases:\n    print([(c.id,c.score,c.seq) for c in sort_by_score(items)])\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
