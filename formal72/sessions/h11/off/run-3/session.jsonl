{"type":"item.started","item":{"id":"item_229","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\nfrom dataclasses import dataclass\n@dataclass\nclass C:\n    id:str; zone:str; score:int; seq:int; active:bool\n@dataclass\nclass S:\n    out:list; inserted:bool\n\ndef better(a,b):\n    if a.score\"'!=b.score: return a.score>b.score\n    return a.seq<b.seq\n\ndef insert_one(st,item):\n    n=len(st.out); acc=S([],False)\n    for i in range(n):\n        cur=st.out[i]\n        if acc.inserted:\n            acc=S(acc.out+[cur],True)\n        else:\n            if better(item,cur):\n                acc=S(acc.out+[item,cur],True)\n            else:\n                acc=S(acc.out+[cur],False)\n    return acc if acc.inserted else S(acc.out+[item],False)\n\ndef sort_by_score(items):\n    st=S([],False)\n    for it in items: st=insert_one(st,it)\n    return st.out\n\n# candidate new better: only true when same id and strictly better? \ndef better2(a,b):\n    if a.id!=b.id: return False\n    if a.score!=b.score: return a.score>b.score\n    return a.seq<b.seq\n\nprint(\"--- better2 (same-id only) ---\")\nfor items in [\n  [C(\"a\",\"n\",5,1,True),C(\"a\",\"s\",3,2,True),C(\"b\",\"e\",7,3,True)],\n  [C(\"a\",\"n\",3,1,True),C(\"a\",\"s\",5,2,True)],\n]:\n    st=S([],False)\n    for it in items: st=insert_one(st,it)\n    print([(c.id,c.score,c.seq) for c in st.out])\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
