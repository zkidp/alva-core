{"type":"item.started","item":{"id":"item_141","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\nfrom dataclasses import dataclass\nimport random\n\n@dataclass\nclass C:\n    id: str; zone: str; score: int; seq: int; active: bool\n\n@dataclass\nclass S:\n    out: list; inserted: bool\n\ndef better(a,b):\n    if a.score \"'!= b.score:\n        return a.score > b.score\n    return a.seq < b.seq\n\ndef same_id(a,b):\n    return a.id == b.id\n\ndef insert_one(st, item):\n    n = len(st.out)\n    acc = S([], False)\n    for i in range(n):\n        cur = st.out[i]\n        if acc.inserted:\n            if same_id(item, cur):\n                acc = S(acc.out, True)\n            else:\n                acc = S(acc.out + [cur], True)\n        else:\n            if same_id(item, cur):\n                if better(item, cur):\n                    acc = S(acc.out + [item], True)\n                else:\n                    acc = S(acc.out + [cur], True)\n            else:\n                if better(item, cur):\n                    acc = S(acc.out + [item, cur], True)\n                else:\n                    acc = S(acc.out + [cur], False)\n    if acc.inserted:\n        return acc\n    else:\n        return S(acc.out + [item], False)\n\ndef sort_by_score(items):\n    st = S([], False)\n    for it in items:\n        st = insert_one(st, it)\n    return st.out\n\ndef normalize(items):\n    return sort_by_score([c for c in items if c.active])\n\n# Correct reference:\n# 1. keep active; 2. dedup by id keeping best (score desc, seq asc; first on full tie)\n# 3. sort by score desc, seq asc, stable by first-occurrence order.\ndef reference(items):\n    active=[c for c in items if c.active]\n    best={}; first_order=[]\n    for idx,c in enumerate(active):\n        if c.id not in best:\n            best[c.id]=(c, idx)\n        else:\n            b,bi=best[c.id]\n            if (c.score, -c.seq) > (b.score, -b.seq):\n                best[c.id]=(c, idx)\n    res=[(c,idx) for c,idx in best.values()]\n    res.sort(key=lambda p:(-p[0].score, p[0].seq, p[1]))\n    return [c for c,_ in res]\n\nrandom.seed(1)\nok=True\nfor t in range(10000):\n    n=random.randint(0,9)\n    items=[C(random.choice(\"abcde\"),\"z\",random.randint(1,5),random.randint(1,4),random.random()<0.8) for _ in range(n)]\n    a=normalize(items); b=reference(items)\n    if a!=b:\n        print(\"MISMATCH\", t, [(c.id,c.score,c.seq,c.active) for c in items], \"=>\", [(c.id,c.score,c.seq) for c in a], \"vs\", [(c.id,c.score,c.seq) for c in b])\n        ok=False\n        break\nprint(\"stress:\", \"OK\" if ok else \"FAIL\")\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
