{"type":"item.started","item":{"id":"item_138","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\nfrom dataclasses import dataclass\nimport random\n\n@dataclass\nclass C:\n    id: str; zone: str; score: int; seq: int; active: bool\n\n@dataclass\nclass S:\n    out: list; inserted: bool\n\ndef better(a,b):\n    if a.score \"'!= b.score:\n        return a.score > b.score\n    return a.seq < b.seq\n\ndef same_id(a,b):\n    return a.id == b.id\n\n# New algorithm: \n# - acc.inserted branch: if cur has same id as item -> skip cur (dedup); else copy cur.\n# - else branch: same_id(item,cur): if better -> replace cur with item; else -> skip item (keep cur, mark handled).\n#   different id: if better(item,cur) -> insert before cur; else keep cur (continue scan).\ndef insert_one(st, item):\n    n = len(st.out)\n    acc = S([], False)\n    for i in range(n):\n        cur = st.out[i]\n        if acc.inserted:\n            if same_id(item, cur):\n                acc = S(acc.out, True)      # skip duplicate\n            else:\n                acc = S(acc.out + [cur], True)\n        else:\n            if same_id(item, cur):\n                if better(item, cur):\n                    acc = S(acc.out + [item], True)   # replace cur with item\n                else:\n                    acc = S(acc.out + [cur], True)    # skip item, keep cur\n            else:\n                if better(item, cur):\n                    acc = S(acc.out + [item, cur], True)\n                else:\n                    acc = S(acc.out + [cur], False)\n    if acc.inserted:\n        return acc\n    else:\n        return S(acc.out + [item], False)\n\ndef sort_by_score(items):\n    st = S([], False)\n    for it in items:\n        st = insert_one(st, it)\n    return st.out\n\ndef normalize(items):\n    return sort_by_score([c for c in items if c.active])\n\ndef run(name, items):\n    out = normalize(items)\n    print(name, \"=>\", [(c.id,c.score,c.seq) for c in out] if out else \"EMPTY\")\n\nrun(\"filter_basic\", [C(\"a\",\"n\",5,1,True), C(\"b\",\"s\",9,2,False), C(\"c\",\"e\",3,3,True)])\nrun(\"score_order\", [C(\"x\",\"n\",1,1,True), C(\"y\",\"s\",9,2,True), C(\"z\",\"e\",5,3,True)])\nrun(\"dedup_basic\", [C(\"a\",\"n\",5,1,True), C(\"a\",\"s\",3,2,True), C(\"b\",\"e\",7,3,True)])\nrun(\"dedup_winner\", [C(\"a\",\"n\",3,1,True), C(\"a\",\"s\",5,2,True)])\nrun(\"tie_seq\", [C(\"a\",\"n\",5,2,True), C(\"b\",\"s\",5,1,True)])\nrun(\"stable_tie\", [C(\"a\",\"n\",5,7,True), C(\"b\",\"s\",5,7,True)])\nrun(\"permuted\", [C(\"p\",\"n\",4,1,True), C(\"q\",\"s\",8,2,True), C(\"r\",\"e\",2,3,True)])\nrun(\"empty\", [])\nrun(\"regression3\", [C(\"c\",\"z\",2,1,False), C(\"a\",\"z\",1,1,True), C(\"a\",\"z\",4,2,False), C(\"a\",\"z\",5,2,True), C(\"d\",\"z\",5,2,True), C(\"b\",\"z\",4,3,False), C(\"d\",\"z\",5,1,True)])\n\ndef reference(items):\n    items=[c for c in items if c.active]\n    best={}; order=[]\n    for c in items:\n        if c.id not in best:\n            best[c.id]=c; order.append(c.id)\n        else:\n            b=best[c.id]\n            if (c.score, -c.seq) > (b.score, -b.seq):\n                best[c.id]=c\n    res=[best[i] for i in order]\n    res=sorted(res, key=lambda c:(-c.score, c.seq))\n    return res\n\nrandom.seed(1)\nok=True\nfor t in range(5000):\n    n=random.randint(0,8)\n    items=[C(random.choice(\"abcde\"),\"z\",random.randint(1,5),random.randint(1,4),random.random()<0.8) for _ in range(n)]\n    a=normalize(items); b=reference(items)\n    if a!=b:\n        print(\"MISMATCH\", t, [(c.id,c.score,c.seq,c.active) for c in items], \"=>\", [(c.id,c.score,c.seq) for c in a], \"vs\", [(c.id,c.score,c.seq) for c in b])\n        ok=False\n        break\nprint(\"stress:\", \"OK\" if ok else \"FAIL\")\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
