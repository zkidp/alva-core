{"type":"item.started","item":{"id":"item_93","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\nimport subprocess, json, re\n\ndef aep(tool, **kw):\n    args = ['python3','/opt/alva/aep.py','--port','43811',tool]\n    for k,v in kw.items():\n        args.append(f'{k}={v}')\n    out = subprocess.run(args, capture_output=True, text=True).stdout\n    j = json.loads(out)\n    if not j.get('ok'):\n        raise SystemExit(f\\\"{tool}: {j.get('message')}\\\")\n    return j['result']\n\ndef entity(rev):\n    return aep('inspect_entity', entity=rev)\n\nseen = {}\ndef walk(rev):\n    if rev in seen: return\n    seen[rev] = None\n    r = entity(rev)\n    kind = r['kind']\n    f = r.get('fields',{}); s = r.get('slots',{})\n    if kind == 'field':\n        refname = ''\n        val = s.get('value')\n        if val:\n            vr = entity(val[0])\n            if vr['kind']=='ref': refname = vr['fields'].get('name','')\n        print(f'FIELD {rev[:12]} name={f.get(\\\"name\\\")} value_ref={refname} value_kind={vr[\\\"kind\\\"] if val else \\\"\\\"}')\n    for slot, vals in s.items():\n        if isinstance(vals, list):\n            for v in vals: walk(v)\n        else: walk(vals)\n\nmod = aep('inspect_module', name='h11.dispatch')\nview = mod['view']\nfns = re.findall(r'\\\\bfn (\\\\w+)', view)\nfor fn in fns:\n    try:\n        r = aep('inspect_function', name='h11.dispatch.'+fn)\n    except SystemExit:\n        continue\n    body = r.get('body')\n    m = re.search(r'\\\\(block rev=([0-9a-f]+)', body or '')\n    if not m:\n        print(fn, 'no body')\n        continue\n    print('##', fn)\n    walk(m.group(1))\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
