{"type":"item.started","item":{"id":"item_199","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\nimport subprocess, json, re\n\ndef aep(tool, **kw):\n    args = ['python3','/opt/alva/aep.py','--port','43811',tool]\n    for k,v in kw.items():\n        args.append(f'{k}={v}')\n    out = subprocess.run(args, capture_output=True, text=True).stdout\n    j = json.loads(out)\n    if not j.get('ok'):\n        raise SystemExit(f\\\"{tool}: {j.get('message')}\\\")\n    return j['result']\n\ndef show(rev, indent=0, maxdepth=20, label=''):\n    pad='  '*indent\n    if indent>=maxdepth:\n        print(pad+'...'); return\n    r = aep('inspect_entity', entity=rev)\n    kind=r['kind']; f=r.get('fields',{}); s=r.get('slots',{})\n    ftext = {k:v for k,v in f.items() if k in ('name','value','op','acc_name','index','elem_var','pure')}\n    print(f'{pad}{label}{kind} {rev[:10]} {json.dumps(ftext)}')\n    for slot, vals in s.items():\n        if slot in ('inv','post','pre'): continue\n        if isinstance(vals, list):\n            for v in vals: show(v, indent+1, maxdepth)\n        else: show(vals, indent+1, maxdepth)\n\nfor fn in ['h11.dispatch.better','h11.dispatch.insert_one','h11.dispatch.sort_by_score','h11.dispatch.normalize','h11.dispatch.print_list']:\n    r = aep('inspect_function', name=fn)\n    print('====',fn,'====')\n    m = re.search(r'\\\\(block rev=([0-9a-f]+)', r['body'])\n    show(m.group(1))\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
