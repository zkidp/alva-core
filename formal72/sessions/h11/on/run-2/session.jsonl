st_ok=True)\n    with open(os.path.join(state_dir, \"port.txt\"), \"w\", encoding=\"utf-8\") as fh:\n        fh.write(str(actual_port) + \"\\n\")\n    with open(os.path.join(state_dir, \"pid.txt\"), \"w\", encoding=\"utf-8\") as fh:\n        fh.write(str(os.getpid()) + \"\\n\")\n\n    def serve_loop():\n        while not stopped[\"v\"]:\n            try:\n===\ntotal 0\n/usr/local/bin/alva\n","exit_code":0,"status":"completed"}}
