v, src_rev):\n    \\\"\\\"\\\"Mutate src_rev field node to (name, ref_rev) - mutates in place, returns src_rev.\\\"\\\"\\\"\n    f = fld(src_rev)\n    if f[\\\"fields\\\"].get(\\\"name\\\") \"'!= name:\n        rev(call(\"change_field\", entity=src_rev, field=\"name\", value=name), f\"name->{name}\")\n    cur_val = fld(src_rev)[\"slots\"][\"value\"][0]\n    if cur_val != ref_rev:\n        rev(call(\"replace_expression\", parent=src_rev, child=ref_rev, position=\"value\"), f\"val->{ref_rev[:8]}\")\n    return src_rev\n\n# (seq, ref a): from ASCORE\nASEQ = mk_field(\"seq\", REF_A, ASCORE)\n# (seq, ref b): from BSCORE\nBSEQ = mk_field(\"seq\", REF_B, BSCORE)\n# (score, ref a): recreate from F_OUT_RES (currently out/ref res)\nN_ASCORE = mk_field(\"score\", REF_A, F_OUT_RES)\n# (score, ref b): need a source. Sacrifice (inserted, ref s) F_INS_S -> will recreate INS_S later from another source\nN_BSCORE = mk_field(\"score\", REF_B, F_INS_S)\n# (id, ref cur): from F_INS_RES\nCURID = mk_field(\"id\", REF_CUR, F_INS_RES)\n# (id, ref item): need source... none left except created nodes.\n# Let'\"'s instead use fresh-ref value nodes (rename trick) - create fresh refs and rename to cur/item\n# (id, ref cur): from F_INS_RES (inserted, ref res) -> (id, ref res) then value->fresh ref renamed cur\nf = fld(F_INS_RES)\nif f[\\\"fields\\\"].get(\\\"name\\\") \"'!= \"id\":\n    rev(call(\"change_field\", entity=F_INS_RES, field=\"name\", value=\"id\"), \"id-cur name\")\nRCUR = rev(call(\"create_reference\", name=\"zz_cur\"), \"zz cur\")\nrev(call(\"replace_expression\", parent=F_INS_RES, child=RCUR, position=\"value\"), \"id-cur val\")\nrev(call(\"change_field\", entity=RCUR, field=\"name\", value=\"cur\"), \"cur\")\nCURID = F_INS_RES\n# (id, ref item): from a new source - need another sacrificial field node.\n# Available: the post-fold append'\"'s field (out, ref res) is OUT_RES (ee5aedb6)? No - F_OUT_RES was used for N_ASCORE.\n# Actually ee5aedb6 IS F_OUT_RES. We used it. Sources lef