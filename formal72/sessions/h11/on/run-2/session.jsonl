change_field\\\", entity=F_INS_S, field=\\\"name\\\", value=\\\"id\\\"), \\\"M1a\\\")\nrev(call(\\\"replace_expression\\\", parent=F_INS_S, child=REF_CUR, position=\\\"value\\\"), \\\"M1b\\\")\nCURID = F_INS_S\n# find preserved (inserted, ref s) = fold if cond\nb = ins_one()\nm = re.search(r\\\"binding name=cur rev=([0-9a-f]+) body:\\\\(\\\\(if rev=([0-9a-f]+) cond:\\\\(\\\\(field name=(\\\\w+) rev=([0-9a-f]+) value:\\\\(\\\\(ref name=(\\\\w+)\\\", b)\nCUR_BIND, FOLD_IF, _, INS_S, _ = m.groups()\nprint(\\\"M1: CURID\\\", CURID[:12], \\\"INS_S\\\", INS_S[:12])\n\n# M2: F_INS_RES (inserted, ref res) -> (id, ref item). Parent (post-fold cond) gets preserved (inserted, ref res).\nrev(call(\\\"change_field\\\", entity=F_INS_RES, field=\\\"name\\\", value=\\\"id\\\"), \\\"M2a\\\")\nrev(call(\\\"replace_expression\\\", parent=F_INS_RES, child=REF_ITEM, position=\\\"value\\\"), \\\"M2b\\\")\nITEMID = F_INS_RES\nb = ins_one()\nm = re.search(r\\\"body:\\\\(\\\\(if rev=([0-9a-f]+) cond:\\\\(\\\\(field name=(\\\\w+) rev=([0-9a-f]+) value:\\\\(\\\\(ref name=(\\\\w+)\\\", b)\nPOST_IF, _, INS_RES, _ = m.groups()\nprint(\\\"M2: ITEMID\\\", ITEMID[:12], \\\"INS_RES\\\", INS_RES[:12])\n\n# M3: ASCORE (score, ref a) -> (seq, ref a). Parent (better binary left) gets preserved (score, ref a).\nrev(call(\\\"change_field\\\", entity=ASCORE, field=\\\"name\\\", value=\\\"seq\\\"), \\\"M3\\\")\nASEQ = ASCORE\nbb = body_of(\\\"h11.dispatch.better\\\")\nm = re.search(r\\\"left:\\\\(\\\\(field name=(\\\\w+) rev=([0-9a-f]+) value:\\\\(\\\\(ref name=(\\\\w+)\\\", bb)\nSCORE_A_PRES, _ = m.group(1), m.group(2)\n# M4: BSCORE (score, ref b) -> (seq, ref b). Parent gets preserved (score, ref b).\nrev(call(\\\"change_field\\\", entity=BSCORE, field=\\\"name\\\", value=\\\"seq\\\"), \\\"M4\\\")\nBSEQ = BSCORE\nbb = body_of(\\\"h11.dispatch.better\\\")\nm = re.search(r\\\"right:\\\\(\\\\(field name=(\\\\w+) rev=([0-9a-f]+) value:\\\\(\\\\(ref name=(\\\\w+)\\\", bb)\nSCORE_B_PRES = m.group(2)\nprint(\\\"M3/M4: ASEQ\\\", ASEQ[:12], \\\"BSEQ\\\", BSEQ[:12], \\\"SCORE_A_PRES\\\", SCORE_A_PRES[:12], \\\"SCORE_B_PRES\\\", SCORE_B_PRES[:12])\n\n# M5: create (score, ref a) and (score, ref b) for NEW better: sacrifice F_OUT_RES (out, ref res) for (score, ref a)\nrev(call(\\\"change_field\\\", entity=F_OUT_RES, field=\\\"name\\\", value=\\\"score\\\"), \\\"M5a\\\")\nrev(call(\\\"replace_expression\\\", parent=F_OUT_RES, child=REF_A, position=\\\"value\\\"), \\\"M5b\\\")\nASCORE2 = F_OUT_RES\n# M6: (score, ref b): sacrifice CURID? no. Use the preserved (score, ref a) from M3? that's SCORE_A_PRES.\n# We need TWO score nodes: (score, ref a) and (score, ref b). ASCORE2 is (score, ref a). For (score, ref b):\n# sacrifice INS_S (preserved inserted ref s from M1) -> (score, ref b)\nrev(call(\\\"change_field\\\", entity=INS_S, field=\\\"name\\\", value=\\\"score\\\"), \\\"M6a\\\")\nrev(call(\\\"replace_expression\\\", parent=INS_S, child=REF_B, position=\\\"value\\\"), \\\"M6b\\\")\nBSCORE2 = INS_S\nprint(\\\"M5/M6: ASCORE2\\\", ASCORE2[:12], fld(ASCORE2)[\\\"fields\\\"], \\\"BSCORE2\\\", BSCORE2[:12], fld(BSCORE2)[\\\"fields\\\"])\njson.dump({\\\"CURID\\\":CURID,\\\"ITEMID\\\":ITEMID,\\\"ASEQ\\\":ASEQ,\\\"BSEQ\\\":BSEQ,\\\"ASCORE2\\\":ASCORE2,\\\"BSCORE2\\\":BSCORE2,\\\"INS_S\\\":INS_S,\\\"INS_RES\\\":INS_RES,\\\"CUR_BIND\\\":CUR_BIND,\\\"FOLD_IF\\\":FOLD_IF,\\\"POST_IF\\\":POST_IF}, open(\\\"/tmp/v2_state.json\\\",\\\"w\\\"))\nprint(\\\"MUTATIONS DONE\\\")\nPYEOF\npython3 /tmp/build_full_v2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
