ther source. Current body still has (out, ref st) e4630fff (needed) and... after INS_S mutation the post-fold append rewired.\n# Available: the post-fold append's field was ee5aedb6 (now INS_S). Recreate (out, ref res)? we need INS_RES.\n# Use e4630fff (out, ref st) -> mutate to (inserted, ref res); then recreate (out, ref st) from preserved copy after rewire.\nF_OUT_ST=\\\"e4630fffa2f3b1b9b7c1974dfd576371165e4524d2803655b51cf93a1f5ea427\\\"\nrev(call(\\\"change_field\\\", entity=F_OUT_ST, field=\\\"name\\\", value=\\\"inserted\\\"), \\\"i2a\\\")\nrev(call(\\\"replace_expression\\\", parent=F_OUT_ST, child=REF_RES, position=\\\"value\\\"), \\\"i2b\\\")\nINS_RES = F_OUT_ST\nprint(\\\"INS_RES\\\", INS_RES[:12], fld(INS_RES)[\\\"fields\\\"], fld(INS_RES)[\\\"slots\\\"][\\\"value\\\"][0][:12])\n# find preserved (out, ref st) in body for get/len\nb = ins_one()\nm = re.search(r\\\"call name=get rev=([0-9a-f]+) args:\\\\(\\\\(field name=out rev=([0-9a-f]+)\\\", b)\nGET_CALL, OUT_ST_PRES = m.group(1), m.group(2)\nprint(\\\"GET_CALL\\\", GET_CALL[:12], \\\"OUT_ST_PRES\\\", OUT_ST_PRES[:12], fld(OUT_ST_PRES)[\\\"fields\\\"])\n\nprint(\\\"===== build record updates =====\\\")\nAPPEND_ITEM = rev(call(\\\"create_call\\\", name=\\\"append\\\", args=[OUT_S, REF_ITEM]), \\\"r1\\\")\nRU_REPLACE = rev(call(\\\"update_record_fields\\\", type=\\\"SortState\\\", base=REF_S, updates={\\\"out\\\": APPEND_ITEM, \\\"inserted\\\": TRUE}), \\\"r2\\\")\nAPPEND_CUR = rev(call(\\\"create_call\\\", name=\\\"append\\\", args=[OUT_S, REF_CUR]), \\\"r3\\\")\nRU_KEEP = rev(call(\\\"update_record_fields\\\", type=\\\"SortState\\\", base=REF_S, updates={\\\"out\\\": APPEND_CUR, \\\"inserted\\\": TRUE}), \\\"r4\\\")\nprint(\\\"RU_REPLACE\\\", RU_REPLACE[:12], \\\"RU_KEEP\\\", RU_KEEP[:12])\n\nprint(\\\"===== rebuild better =====\\\")\nGT = rev(call(\\\"create_binary\\\", op=\\\">\\\", left=ASCORE2, right=BSCORE2), \\\"b1\\\")\nLT = rev(call(\\\"create_binary\\\", op=\\\"<\\\", left=ASEQ, right=BSEQ), \\\"b2\\\")\nFLS = rev(call(\\\"create_literal\\\", type=\\\"bool\\\", value=\\\"false\\\"), \\\"b3\\\")\nIF2 = rev(call(\\\"create_if\\\", **{\\\"cond\\\": LT, \\\"then\\\": TRUE, \\\"else\\\": FLS}), \\\"b4\\\")\nIF1 = rev(call(\\\"create_if\\\", **{\\\"cond\\\": GT, \\\"then\\\": TRUE, \\\"else\\\": IF2}), \\\"b5\\\")\nbb = body_of(\\\"h11.dispatch.better\\\")\nm = re.search(r\\\"\\\\(block rev=([0-9a-f]+)\\\", bb)\nBB = m.group(1)\nrev(call(\\\"replace_expression\\\", parent=BB, child=IF1, position=\\\"step\\\"), \\\"b6\\\")\nprint(\\\"better rebuilt\\\")\n\nprint(\\\"===== rebuild insert_one =====\\\")\nb = ins_one()\nm = re.search(r\\\"binding name=res rev=([0-9a-f]+) body:\\\\(\\\\(if rev=([0-9a-f]+)\\\", b)\nRES_BIND, POST_IF = m.group(1), m.group(2)\nPOST_NEW = rev(call(\\\"create_if\\\", **{\\\"cond\\\": INS_RES, \\\"then\\\": REF_RES, \\\"else\\\": POST_RU}), \\\"p1\\\")\nrev(call(\\\"replace_expression\\\", parent=RES_BIND, child=POST_NEW, position=\\\"body\\\"), \\\"p2\\\")\nb = ins_one()\nm = re.search(r\\\"binding name=cur rev=([0-9a-f]+) body:\\\\(\\\\(if rev=([0-9a-f]+)\\\", b)\nCUR_BIND, FOLD_IF = m.group(1), m.group(2)\nEQID = rev(call(\\\"create_binary\\\", op=\\\"==\\\", left=CURID, right=ITEMID), \\\"f1\\\")\nBETTER_CALL = rev(call(\\\"create_call\\\", name=\\\"better\\\", args=[REF_ITEM, REF_CUR]), \\\"f2\\\")\nINNER1 = rev(call(\\\"create_if\\\", **{\\\"cond\\\": BETTER_CALL, \\\"then\\\": RU_REPLACE, \\\"else\\\": RU_KEEP}), \\\"f3\\\")\nINNER2_ELSE = rev(call(\\\"create_if\\\", **{\\\"cond\\\": BETTER_CALL, \\\"then\\\": RU_INS_BEFORE, \\\"else\\\": RU_APPEND_CUR}), \\\"f4\\\")\nINNER2 = rev(call(\\\"create_if\\\", **{\\\"cond\\\": EQID, \\\"then\\\": INNER1, \\\"else\\\": INNER2_ELSE}), \\\"f5\\\")\nTHEN_IF = rev(call(\\\"create_if\\\", **{\\\"cond\\\": EQID, \\\"then\\\": REF_S, \\\"else\\\": RU_APPEND_CUR}), \\\"f6\\\")\nOUTER = rev(call(\\\"create_if\\\", **{\\\"cond\\\": INS_S, \\\"then\\\": THEN_IF, \\\"else\\\": INNER2}), \\\"f7\\\")\n