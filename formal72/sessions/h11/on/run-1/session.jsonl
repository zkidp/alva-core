{"type":"item.started","item":{"id":"item_347","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\nfrom itertools import permutations\ndef mk(i,z,s,q,a=True): return {'id':i,'zone':z,'score':s,'seq':q,'active':a}\ndef better(item, cur):\n    return item['score'] > cur['score'] or (item['score'] == cur['score'] and item['seq'] < cur['seq'])\ndef insert_one(st, item):\n    out = []\n    inserted = False\n    for cur in st['out']:\n        if inserted:\n            if cur['id'] == item['id']:\n                continue\n            out.append(cur)\n        elif better(item, cur):\n            if cur['id'] == item['id']:\n                out.append(item); inserted = True   # replace\n            else:\n                out.append(item); out.append(cur); inserted = True\n        else:\n            if cur['id'] == item['id']:\n                inserted = True                      # dup found -> drop item\n                out.append(cur)\n            else:\n                out.append(cur)\n    if not inserted:\n        out.append(item)\n    return {'out': out, 'inserted': inserted}\ndef normalize(items):\n    st = {'out': [], 'inserted': False}\n    for it in [x for x in items if x['active']]:\n        st = insert_one(st, it)\n    return st['out']\nscen = {\n 'filter_basic': [mk('a','n',5,1), mk('b','s',9,2,False), mk('c','e',3,3)],\n 'score_order':  [mk('x','n',1,1), mk('y','s',9,2), mk('z','e',5,3)],\n 'dedup_basic':  [mk('a','n',5,1), mk('a','s',3,2), mk('b','e',7,3)],\n 'dedup_winner': [mk('a','n',3,1), mk('a','s',5,2)],\n 'tie_seq':      [mk('a','n',5,2), mk('b','s',5,1)],\n 'stable_tie':   [mk('a','n',5,7), mk('b','s',5,7)],\n 'permuted':     [mk('p','n',4,1), mk('q','s',8,2), mk('r','e',2,3)],\n}\nfor name, items in scen.items():\n    outs = set()\n    bad = False\n    for perm in permutations(items):\n        out = normalize(list(perm))\n        outs.add(tuple((c['id'],c['score']) for c in out))\n    print(name, sorted(outs))\n# stress: random records with dup ids\nimport random\nrandom.seed(1)\nfor trial in range(2000):\n    n = random.randint(1,6)\n    items = []\n    for i in range(n):\n        items.append(mk(random.choice('abc'),'z',random.randint(1,10),random.randint(1,10), random.random()<0.8))\n    # expected: filter, dedup best, sort\n    active = [x for x in items if x['active']]\n    best = {}\n    for x in active:\n        if x['id'] not in best or (x['score']>best[x['id']]['score']) or (x['score']==best[x['id']]['score'] and x['seq']<best[x['id']]['seq']):\n            best[x['id']] = x\n    exp = sorted(best.values(), key=lambda x: (-x['score'], x['seq']))\n    got = normalize(items)\n    if [(c['id'],c['score'],c['seq']) for c in got] \"'!= [(c['\"'id'],c['score'],c['seq']) for c in exp]:\n        print(\\\"MISMATCH trial\\\", trial)\n        print(\\\"  in:\\\", [(x['id'],x['score'],x['seq'],x['active']) for x in items])\n        print(\\\"  got:\\\", [(c['id'],c['score'],c['seq']) for c in got])\n        print(\\\"  exp:\\\", [(c['id'],c['score'],c['seq']) for c in exp])\n        break\nelse:\n    print(\\\"2000 random trials passed\\\")\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
