{"type":"item.started","item":{"id":"item_125","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\nfrom dataclasses import dataclass\n@dataclass\nclass C:\n    id: str; zone: str; score: int; seq: int; active: bool\n\ndef better(a, b):\n    return a.score > b.score  # current\n\ndef insert_one(st, item):\n    n = len(st['out'])\n    res = {'out': [], 'inserted': False}\n    for i in range(n):\n        cur = st['out'][i]\n        if res['inserted']:\n            res['out'].append(cur)\n        else:\n            if better(item, cur):\n                res['out'].append(item)\n                res['out'].append(cur)\n                res['inserted'] = True\n            else:\n                res['out'].append(cur)\n    if not res['inserted']:\n        res['out'].append(item)\n    return res\n\ndef sort_by_score(items):\n    st = {'out': [], 'inserted': False}\n    for it in items:\n        st = insert_one(st, it)\n    return st['out']\n\ndef normalize(items):\n    return sort_by_score([x for x in items if x.active])\n\nscenarios = {\n 'sc_filter_basic': [C('a','n',5,1,True), C('b','s',9,2,False), C('c','e',3,3,True)],\n 'sc_score_order':  [C('x','n',1,1,True), C('y','s',9,2,True), C('z','e',5,3,True)],\n 'sc_dedup_basic':  [C('a','n',5,1,True), C('a','s',3,2,True), C('b','e',7,3,True)],\n 'sc_dedup_winner': [C('a','n',3,1,True), C('a','s',5,2,True)],\n 'sc_tie_seq':      [C('a','n',5,2,True), C('b','s',5,1,True)],\n 'sc_stable_tie':   [C('a','n',5,7,True), C('b','s',5,7,True)],\n 'sc_permuted':     [C('p','n',4,1,True), C('q','s',8,2,True), C('r','e',2,3,True)],\n 'sc_empty':        [],\n}\nfor name, items in scenarios.items():\n    out = normalize(items)\n    print(name, '=>', [(c.id, c.score) for c in out] or 'EMPTY')\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
