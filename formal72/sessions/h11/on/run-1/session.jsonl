{"type":"item.started","item":{"id":"item_348","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\nfrom itertools import permutations\ndef mk(i,z,s,q,a=True): return {'id':i,'zone':z,'score':s,'seq':q,'active':a}\ndef better(item, cur):\n    # score desc, then seq asc; strictly less means item ranks before cur\n    return item['score'] > cur['score'] or (item['score'] == cur['score'] and item['seq'] < cur['seq'])\ndef insert_one(st, item):\n    out = []\n    inserted = False\n    for cur in st['out']:\n        if inserted:\n            if cur['id'] == item['id']:\n                continue\n            out.append(cur)\n        elif better(item, cur):\n            if cur['id'] == item['id']:\n                out.append(item); inserted = True\n            else:\n                out.append(item); out.append(cur); inserted = True\n        else:\n            if cur['id'] == item['id']:\n                inserted = True\n                out.append(cur)\n            else:\n                out.append(cur)\n    if not inserted:\n        out.append(item)\n    return {'out': out, 'inserted': inserted}\ndef normalize(items):\n    st = {'out': [], 'inserted': False}\n    for it in [x for x in items if x['active']]:\n        st = insert_one(st, it)\n    return st['out']\nimport random\nrandom.seed(1)\nmism = 0\nfor trial in range(20000):\n    n = random.randint(1,7)\n    items = []\n    for i in range(n):\n        items.append(mk(random.choice('abcd'),'z',random.randint(1,10),random.randint(1,10), random.random()<0.8))\n    active = [x for x in items if x['active']]\n    best = {}\n    for x in active:\n        if x['id'] not in best or (x['score']>best[x['id']]['score']) or (x['score']==best[x['id']]['score'] and x['seq']<best[x['id']]['seq']):\n            best[x['id']] = x\n    # stable sort: preserve original order among fully-equal keys\n    order = {id(x): i for i,x in enumerate(active)}\n    exp = sorted(best.values(), key=lambda x: (-x['score'], x['seq']))\n    # stability: python sort is stable, keys are (-score, seq); best list built in first-occurrence order\n    got = normalize(items)\n    def key(c): return (c['id'],c['score'],c['seq'])\n    if [key(c) for c in got] \"'!= [key(c) for c in exp]:\n        mism += 1\n        if mism <= 3:\n            print(\"MISMATCH\", trial)\n            print(\"  in:\", [(x['\"'id'],x['score'],x['seq'],x['active']) for x in items])\n            print(\\\"  got:\\\", [key(c) for c in got])\n            print(\\\"  exp:\\\", [key(c) for c in exp])\nprint(\\\"mismatches:\\\", mism, \\\"of 20000\\\")\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
