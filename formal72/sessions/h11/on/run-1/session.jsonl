{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\n# Simulate the AEP 'insert_one' algorithm to verify behavior under different 'better' semantics.\nfrom dataclasses import dataclass\n@dataclass\nclass C:\n    id: str; score: int; seq: int\n\ndef sim(initial, new, better, skip_dup=False):\n    n = len(initial)\n    out = []\n    inserted = False\n    dup = False\n    for idx in range(n):\n        cur = initial[idx]\n        if inserted:\n            out.append(cur)\n        else:\n            if better(new, cur):\n                out.append(new)\n                out.append(cur)\n                inserted = True\n            else:\n                if skip_dup and new.id == cur.id:\n                    dup = True\n                out.append(cur)\n    if not inserted and not dup:\n        out.append(new)\n    return out\n\ndef better_strict(a, b):\n    # same id: strictly better; different id: sort order\n    if a.id == b.id:\n        return a.score > b.score or (a.score == b.score and a.seq < b.seq)\n    return a.score > b.score or (a.score == b.score and a.seq < b.seq)\n\ntests = [\n    (\\\"worse dup after better\\\", [C('a',5,1)], C('a',3,2)),\n    (\\\"better dup after worse\\\", [C('a',3,1)], C('a',5,2)),\n    (\\\"equal score lower seq\\\", [C('a',5,2)], C('a',5,0)),\n    (\\\"equal score higher seq\\\", [C('a',5,0)], C('a',5,2)),\n    (\\\"identical\\\", [C('a',5,1)], C('a',5,1)),\n    (\\\"cross-id insert middle\\\", [C('b',9,0), C('d',2,1)], C('c',5,0)),\n    (\\\"same id better with earlier cross-id worse\\\", [C('b',3,1), C('a',5,1)], C('a',7,2)),\n]\nfor name, initial, new in tests:\n    print(name, \\\"=>\\\", [(c.id,c.score,c.seq) for c in sim(initial, new, better_strict, skip_dup=True)])\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
