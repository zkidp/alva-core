{"type":"item.started","item":{"id":"item_320","type":"command_execution","command":"/bin/sh -lc \"python3 /opt/alva/aep.py --port 38299 abort_transaction >/dev/null; python3 - <<'EOF'\n# Simulate the SIMPLER approach: better = (score desc, seq asc); fold body with same-id skip in inserted branch + same-id replace in better branch + dup tracking via inserted flag\nfrom itertools import permutations\n\ndef mk(i, z, s, q, a=True): return {'id':i,'zone':z,'score':s,'seq':q,'active':a}\ndef better(item, cur):\n    return item['score'] > cur['score'] or (item['score'] == cur['score'] and item['seq'] < cur['seq'])\n\ndef insert_one(st, item):\n    out = []\n    inserted = False\n    for cur in st['out']:\n        if inserted:\n            if cur['id'] == item['id']:\n                continue  # skip same-id in tail\n            out.append(cur)\n        elif better(item, cur):\n            if cur['id'] == item['id']:\n                out.append(item)  # replace\n                inserted = True\n            else:\n                out.append(item); out.append(cur)  # insert before\n                inserted = True\n        else:\n            if cur['id'] == item['id']:\n                inserted = True  # dup found, drop item, keep cur\n                out.append(cur)\n            else:\n                out.append(cur)\n    if not inserted:\n        out.append(item)\n    return {'out': out, 'inserted': inserted}\n\ndef sort_by_score(items):\n    st = {'out': [], 'inserted': False}\n    for it in items:\n        st = insert_one(st, it)\n    return st['out']\n\ndef normalize(items):\n    return sort_by_score([x for x in items if x['active']])\n\nscen = {\n 'filter_basic': [mk('a','n',5,1), mk('b','s',9,2,False), mk('c','e',3,3)],\n 'score_order':  [mk('x','n',1,1), mk('y','s',9,2), mk('z','e',5,3)],\n 'dedup_basic':  [mk('a','n',5,1), mk('a','s',3,2), mk('b','e',7,3)],\n 'dedup_winner': [mk('a','n',3,1), mk('a','s',5,2)],\n 'tie_seq':      [mk('a','n',5,2), mk('b','s',5,1)],\n 'stable_tie':   [mk('a','n',5,7), mk('b','s',5,7)],\n 'permuted':     [mk('p','n',4,1), mk('q','s',8,2), mk('r','e',2,3)],\n}\nfor name, items in scen.items():\n    ok = True\n    for perm in permutations(items):\n        out = normalize(list(perm))\n        print(name, [(c['id'],c['score']) for c in out])\n        break\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
