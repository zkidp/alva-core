{"type":"item.started","item":{"id":"item_186","type":"command_execution","command":"/bin/sh -lc \"python3 /opt/alva/aep.py --port 38299 abort_transaction >/dev/null; cat > /tmp/inv.py <<'EOF'\nimport json, subprocess, re\ndef aep(tool, **kv):\n    r = subprocess.run([\\\"python3\\\",\\\"/opt/alva/aep.py\\\",\\\"--port\\\",\\\"38299\\\",tool]+[f\\\"{k}={v}\\\" for k,v in kv.items()], capture_output=True, text=True)\n    return json.loads(r.stdout)\ndef walk(rev, seen, out, depth=0):\n    if rev in seen or depth>60: return\n    seen.add(rev)\n    r = aep(\\\"inspect_entity\\\", entity=rev)\n    if not r.get(\\\"ok\\\"): return\n    res=r[\\\"result\\\"]; slots=res.get(\\\"slots\\\",{})\n    if res.get(\\\"kind\\\")==\\\"field\\\":\n        out.append((rev, res[\\\"fields\\\"][\\\"name\\\"], slots.get(\\\"value\\\",[None])[0]))\n    for ch in slots.values():\n        if isinstance(ch,list):\n            for c in ch: walk(c,seen,out,depth+1)\n        else: walk(ch,seen,out,depth+1)\n# module\nr = aep(\\\"begin_transaction\\\", project=\\\"/workspace/alva.toml\\\")\nmod = aep(\\\"inspect_module\\\", name=\\\"h11.dispatch\\\")\nfns = re.findall(r\\\"fn ([A-Za-z0-9_]+)\\\\(\\\", mod[\\\"result\\\"][\\\"view\\\"])\nseen=set(); allout=[]\nfor fn in fns:\n    rr = aep(\\\"resolve_entity\\\", name=fn, kind=\\\"function\\\", module=\\\"h11.dispatch\\\")\n    if not rr.get(\\\"ok\\\"): continue\n    fr = aep(\\\"inspect_entity\\\", entity=rr[\\\"result\\\"][\\\"entity\\\"])\n    body = fr[\\\"result\\\"][\\\"slots\\\"].get(\\\"body\\\",[None])[0]\n    if body:\n        out=[]\n        walk(body,seen,out)\n        allout.append((fn,out))\nfor fn,out in allout:\n    print(fn, [(o[0][:10],o[1],o[2][:10] if o[2] else None) for o in out])\nEOF\npython3 /tmp/inv.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
