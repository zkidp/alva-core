{"type":"item.started","item":{"id":"item_225","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\nimport struct\ndata = open('/usr/local/bin/alva','rb').read()\ne_shoff = struct.unpack_from('<Q', data, 0x28)[0]\ne_shentsize = struct.unpack_from('<H', data, 0x3a)[0]\ne_shnum = struct.unpack_from('<H', data, 0x3c)[0]\ne_shstrndx = struct.unpack_from('<H', data, 0x3e)[0]\ndef read_cstr(off, limit=600):\n    end = data.index(b'\\\\0', off, off+limit)\n    return data[off:end].decode('utf-8','replace')\nshstr_off = struct.unpack_from('<Q', data, e_shoff + e_shstrndx*e_shentsize + 0x18)[0]\ndef sh_name(i):\n    return read_cstr(shstr_off + struct.unpack_from('<I', data, e_shoff + i*e_shentsize)[0])\nnames = []\nfor i in range(e_shnum):\n    if sh_name(i) == '.symtab':\n        s = struct.unpack_from('<IIQQQQIIQQ', data, e_shoff + i*e_shentsize)\n        off, size, entsize, link = s[4], s[5], s[6], s[7]\n        strsec = None\n        for j in range(e_shnum):\n            if sh_name(j) == '.strtab':\n                strsec = struct.unpack_from('<Q', data, e_shoff + j*e_shentsize + 0x18)[0]\n        n = size // entsize\n        for k in range(n):\n            ent = off + k*entsize\n            st_name = struct.unpack_from('<I', data, ent)[0]\n            if st_name == 0: continue\n            try:\n                nm = read_cstr(strsec + st_name)\n            except ValueError:\n                continue\n            if any(x in nm for x in ['set_field','change_field','add_field','variant','aep','EditSession','add_variant','set_variants','field']):\n                names.append(nm)\n        break\nfor nm in sorted(set(names)):\n    print(nm)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
