{"type":"item.started","item":{"id":"item_234","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\nimport struct, json\ndata = open('/workspace/alva-air/gen-1.air','rb').read()\npos = 11\nnode_count = struct.unpack_from('<I', data, pos)[0]; pos += 4\n\ndef read_u32(pos):\n    return struct.unpack_from('<I', data, pos)[0], pos+4\n\ndef read_str(pos):\n    l, pos = read_u32(pos)\n    return data[pos:pos+l].decode(), pos+l\n\ndef parse_node(pos):\n    rev = data[pos:pos+32].hex(); pos += 32\n    el, pos = read_u32(pos)\n    ent = data[pos:pos+el].decode() if el else ''; pos += el\n    assert data[pos:pos+9] == b'ALVANODE1', (pos, data[pos:pos+12])\n    pos += 9\n    kind, pos = read_str(pos)\n    fcount, pos = read_u32(pos)\n    fields = {}\n    for _ in range(fcount):\n        k, pos = read_str(pos)\n        vt = data[pos]; pos += 1\n        if vt == 1:\n            v, pos = read_str(pos)\n        elif vt == 5:\n            v = bool(data[pos]); pos += 1\n        elif vt == 7:\n            cnt, pos = read_u32(pos)\n            items = []\n            for _ in range(cnt):\n                it, pos = read_str(pos)\n                items.append(it)\n            v = items\n        elif vt == 0:\n            v = data[pos]; pos += 1\n        else:\n            raise Exception('vt %d kind %s field %s at %d' % (vt, kind, k, pos))\n        fields[k] = v\n    scount, pos = read_u32(pos)\n    slots = {}\n    for _ in range(scount):\n        k, pos = read_str(pos)\n        cnt, pos = read_u32(pos)\n        kids = [data[pos+i*32:pos+i*32+32].hex() for i in range(cnt)]\n        pos += cnt*32\n        slots[k] = kids\n    return {'revision': rev, 'entity': ent, 'kind': kind, 'fields': fields, 'slots': slots}, pos\n\nnodes = []\nfor i in range(node_count):\n    n, pos = parse_node(pos)\n    nodes.append(n)\nprint('parsed', len(nodes), 'end', pos, 'total', len(data))\nvj = json.load(open('/workspace/tmp/gen1.json'))\nvmap = {n['revision']: n for n in vj['nodes']}\nbad = 0\nfor n in nodes:\n    v = vmap.get(n['revision'])\n    if v is None:\n        print('missing', n['revision'], n['kind']); bad += 1; continue\n    if v['kind'] \"'!= n['\"'kind'] or v.get('fields',{}) \"'!= n['\"'fields'] or v.get('slots',{}) \"'!= n['\"'slots']:\n        print('MISMATCH', n['revision'], n['kind'], n['fields'], 'vs', v.get('fields')); bad += 1\nprint('bad', bad)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
