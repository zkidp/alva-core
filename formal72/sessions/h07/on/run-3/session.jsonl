\nnodes = []\nfor i in range(node_count):\n    n, pos = parse_node(pos)\n    nodes.append(n)\nprint('parsed', len(nodes), 'end', pos, 'total', len(data))\nvj = json.load(open('/workspace/tmp/gen1.json'))\nvmap = {n['revision']: n for n in vj['nodes']}\nbad = 0\nfor n in nodes:\n    v = vmap.get(n['revision'])\n    if v is None:\n        print('missing', n['revision'], n['kind']); bad += 1; continue\n    if v['kind'] \"'!= n['\"'kind'] or v.get('fields',{}) \"'!= n['\"'fields'] or v.get('slots',{}) \"'!= n['\"'slots']:\n        print('MISMATCH', n['revision'], n['kind']); bad += 1\nprint('bad', bad)\n# print type node\nfor n in nodes:\n    if n['kind'] == 'type':\n        print(json.dumps(n))\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
