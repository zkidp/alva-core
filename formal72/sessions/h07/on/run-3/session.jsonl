{"type":"item.started","item":{"id":"item_227","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\nimport struct, json\ndata = open('/workspace/alva-air/gen-1.air','rb').read()\npos = 0\nassert data[:11] == b'ALVA-AIR-1\\\\n'\npos = 11\nnode_count = struct.unpack_from('<I', data, pos)[0]; pos += 4\nprint('node_count', node_count)\n# try: for each node: revision(32) + 'ALVANODE1' + kind + fields + slots + entity\ndef parse_node(pos):\n    rev = data[pos:pos+32].hex(); pos += 32\n    assert data[pos:pos+9] == b'ALVANODE1', data[pos:pos+9]\n    pos += 9\n    kl = struct.unpack_from('<I', data, pos)[0]; pos += 4\n    kind = data[pos:pos+kl].decode(); pos += kl\n    # fields\n    fcount = struct.unpack_from('<I', data, pos)[0]; pos += 4\n    fields = {}\n    for _ in range(fcount):\n        kl = struct.unpack_from('<I', data, pos)[0]; pos += 4\n        k = data[pos:pos+kl].decode(); pos += kl\n        vt = data[pos]; pos += 1\n        if vt == 1:  # string\n            vl = struct.unpack_from('<I', data, pos)[0]; pos += 4\n            v = data[pos:pos+vl].decode(); pos += vl\n        elif vt == 7:  # vec of strings?\n            cnt = struct.unpack_from('<I', data, pos)[0]; pos += 4\n            items = []\n            for _ in range(cnt):\n                il = struct.unpack_from('<I', data, pos)[0]; pos += 4\n                items.append(data[pos:pos+il].decode()); pos += il\n            v = items\n        else:\n            v = '??type %d' % vt\n            break\n        fields[k] = v\n    # slots\n    scount = struct.unpack_from('<I', data, pos)[0]; pos += 4\n    slots = {}\n    for _ in range(scount):\n        kl = struct.unpack_from('<I', data, pos)[0]; pos += 4\n        k = data[pos:pos+kl].decode(); pos += kl\n        cnt = struct.unpack_from('<I', data, pos)[0]; pos += 4\n        kids = [data[pos+i*32:pos+i*32+32].hex() for i in range(cnt)]\n        pos += cnt*32\n        slots[k] = kids\n    # entity\n    el = struct.unpack_from('<I', data, pos)[0]; pos += 4\n    ent = data[pos:pos+el].decode() if el else ''\n    pos += el\n    return {'revision': rev, 'kind': kind, 'fields': fields, 'slots': slots, 'entity': ent}, pos\n\nnodes = []\nfor i in range(node_count):\n    n, pos = parse_node(pos)\n    nodes.append(n)\nprint('parsed', len(nodes), 'end', pos, 'total', len(data))\n# print type node\nfor n in nodes:\n    if n['kind'] == 'type':\n        print(json.dumps(n))\n# compare with view json\nvj = json.load(open('/workspace/tmp/gen1.json'))\nvmap = {n['revision']: n for n in vj['nodes']}\nok = True\nfor n in nodes:\n    v = vmap.get(n['revision'])\n    if v is None:\n        print('missing in view:', n['revision'], n['kind']); ok = False; continue\n    if v['kind'] \"'!= n['\"'kind'] or v.get('fields',{}) \"'!= n['\"'fields'] or v.get('slots',{}) \"'!= n['\"'slots']:\n        print('MISMATCH', n['revision'])\n        print(' parsed:', json.dumps(n))\n        print(' view:  ', json.dumps(v))\n        ok = False\nprint('match:', ok)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
