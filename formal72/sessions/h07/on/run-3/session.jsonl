{"type":"item.started","item":{"id":"item_248","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\nimport struct, hashlib, subprocess, os\n\ndef enc_str(s):\n    b = s.encode(); return struct.pack('<I', len(b)) + b\n\ndef enc_node(kind, fields, slots):\n    # fields: dict k -> (vt, encoded_value)\n    out = b'ALVANODE1' + enc_str(kind)\n    out += struct.pack('<I', len(fields))\n    for k, (vt, v) in fields.items():\n        out += enc_str(k) + bytes([vt]) + v\n    out += struct.pack('<I', len(slots))\n    for k, kids in slots.items():\n        out += enc_str(k) + struct.pack('<I', len(kids))\n        for kid in kids:\n            out += bytes.fromhex(kid)\n    return out\n\ndata = open('/workspace/alva-air/gen-1.air','rb').read()\npos = 11\ncount = struct.unpack_from('<I', data, pos)[0]; pos += 4\ndef read_u32(p): return struct.unpack_from('<I', data, p)[0], p+4\ndef read_str(p):\n    l,p = read_u32(p); return data[p:p+l].decode(), p+l\nnodes = []\nfor i in range(count):\n    s = pos\n    rev = data[pos:pos+32].hex(); pos += 32\n    el,pos = read_u32(pos); ent = data[pos:pos+el].decode() if el else ''; pos += el\n    assert data[pos:pos+9]==b'ALVANODE1'; pos += 9\n    kind,pos = read_str(pos)\n    fc,pos = read_u32(pos); fields={}\n    for _ in range(fc):\n        k,pos = read_str(pos); vt = data[pos]; pos += 1\n        if vt==1: v,pos = read_str(pos)\n        elif vt==5: v = bool(data[pos]); pos += 1\n        elif vt==7:\n            c,pos = read_u32(pos); items=[]\n            for _ in range(c): it,pos = read_str(pos); items.append(it)\n            v = items\n        elif vt==0: v = data[pos]; pos += 1\n        else: raise Exception(vt)\n        fields[k]=v\n    sc,pos = read_u32(pos); slots={}\n    for _ in range(sc):\n        k,pos = read_str(pos); c,pos = read_u32(pos); kids=[data[pos+j*32:pos+j*32+32].hex() for j in range(c)]; pos += c*32\n        slots[k]=kids\n    nodes.append({'rev':rev,'ent':ent,'kind':kind,'fields':fields,'slots':slots