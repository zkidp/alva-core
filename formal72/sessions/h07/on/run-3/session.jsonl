{"type":"item.started","item":{"id":"item_258","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\nimport struct\nfor f in ['/workspace/alva-air/gen-1.air','/workspace/alva-air/gen-2.air']:\n    data = open(f,'rb').read()\n    # find tail start by parsing nodes\n    pos = 11\n    count = struct.unpack_from('<I', data, pos)[0]; pos += 4\n    def read_u32(p): return struct.unpack_from('<I', data, p)[0], p+4\n    def read_str(p):\n        l,p = read_u32(p); return data[p:p+l].decode(), p+l\n    for i in range(count):\n        pos += 32\n        el,pos = read_u32(pos); pos += el\n        pos += 9\n        kind,pos = read_str(pos)\n        fc,pos = read_u32(pos)\n        for _ in range(fc):\n            k,pos = read_str(pos)\n            vt = data[pos]; pos += 1\n            if vt == 1: _,pos = read_str(pos)\n            elif vt == 5: pos += 1\n            elif vt == 7:\n                c,pos = read_u32(pos)\n                for _ in range(c): _,pos = read_str(pos)\n            elif vt == 0: pos += 1\n            else: raise Exception(vt)\n        sc,pos = read_u32(pos)\n        for _ in range(sc):\n            k,pos = read_str(pos)\n            c,pos = read_u32(pos)\n            pos += c*32\n    tail = data[pos:]\n    print(f, 'tail len', len(tail), 'first bytes', tail[:8].hex(), 'last 40', tail[-40:].hex())\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
