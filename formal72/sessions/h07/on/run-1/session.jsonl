{"type":"item.started","item":{"id":"item_533","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'PY'\nimport struct, glob, os\n# Parse the baseline gen-1 type node's variants field type\ndata = open('/workspace/alva-air/gen-1.air','rb').read()\ni = data.find(b'module:h07.store/type:TaskStatusALVANODE1')\np = i + len(b'module:h07.store/type:TaskStatusALVANODE1')\nklen = struct.unpack_from('<I', data, p)[0]; p += 4+klen\nfc = struct.unpack_from('<I', data, p)[0]; p += 4\nfor _ in range(fc):\n    klen = struct.unpack_from('<I', data, p)[0]; p += 4\n    key = data[p:p+klen].decode(); p += klen\n    typ = data[p]; p += 1\n    print(\\\"field\\\", key, \\\"type tag\\\", typ)\n    if typ == 1:\n        slen = struct.unpack_from('<I', data, p)[0]; p += 4\n        print(\\\"  str\\\", data[p:p+slen]); p += slen\n    elif typ == 7:\n        n = struct.unpack_from('<I', data, p)[0]; p += 4\n        items=[]\n        for _ in range(n):\n            slen = struct.unpack_from('<I', data, p)[0]; p += 4\n            items.append(data[p:p+slen].decode()); p += slen\n        print(\\\"  list\\\", items)\n    elif typ == 2:\n        n = struct.unpack_from('<I', data, p)[0]; p += 4\n        print(\\\"  slot\\\", n); p += n*32\n    else:\n        print(\\\"  other\\\", typ)\n        break\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
