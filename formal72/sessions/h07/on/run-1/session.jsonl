{"type":"item.started","item":{"id":"item_527","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'PY'\nimport struct, glob, os\n# Parse the committed gen-9 type node fully\ndata = open('/workspace/alva-air/gen-9.air','rb').read()\ni = data.find(b'module:h07.store/type:TaskStatusALVANODE1')\nprint(\\\"type node at\\\", i, \\\"of\\\", len(data))\np = i + len(b'module:h07.store/type:TaskStatusALVANODE1')\nklen = struct.unpack_from('<I', data, p)[0]; p += 4\nkind = data[p:p+klen].decode(); p += klen\nprint(\\\"kind:\\\", kind)\nfc = struct.unpack_from('<I', data, p)[0]; p += 4\nprint(\\\"fields:\\\", fc)\nfor _ in range(fc):\n    klen = struct.unpack_from('<I', data, p)[0]; p += 4\n    key = data[p:p+klen].decode(); p += klen\n    typ = data[p]; p += 1\n    if typ == 1:\n        slen = struct.unpack_from('<I', data, p)[0]; p += 4\n        val = data[p:p+slen].decode(errors='replace'); p += slen\n        print(\\\"  str\\\", key, repr(val))\n    elif typ == 7:\n        n = struct.unpack_from('<I', data, p)[0]; p += 4\n        items = []\n        for _ in range(n):\n            slen = struct.unpack_from('<I', data, p)[0]; p += 4\n            items.append(data[p:p+slen].decode(errors='replace')); p += slen\n        print(\\\"  list\\\", key, items)\n    elif typ == 2:\n        n = struct.unpack_from('<I', data, p)[0]; p += 4\n        print(\\\"  slot\\\", key, \\\"count\\\", n)\n        p += n*32\n    else:\n        print(\\\"  other\\\", key, \\\"type\\\", typ)\n        break\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
