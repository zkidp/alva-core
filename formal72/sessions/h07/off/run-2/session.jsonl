{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"/bin/sh -lc 'cat /opt/alva/agent_entrypoint.sh'","aggregated_output":"#!/usr/bin/env bash\nset -euo pipefail\n# Container entrypoint: run the isolation self-test, then the agent.\n/opt/alva/isolation_self_test.sh\nARGS=(-C /workspace -s workspace-write --skip-git-repo-check\n  --ephemeral --json\n  -c \"model_provider=${ALVA_PROVIDER:-deepseek}\"\n  -c preferred_auth_method=apikey\n  -c forced_login_method=api\n  -m \"${CODEX_MODEL:-deepseek-v4-flash}\")\n# The container itself is the isolation boundary (no repo mount, relay-only\n# network), so codex's internal bwrap sandbox is redundant and unavailable\n# here; bypass it inside the container only.\nARGS+=(--dangerously-bypass-approvals-and-sandbox)\n\nif [ \"${MODE:-A}\" = \"C\" ]; then\n  # Start the AEP gateway inside the container (localhost only), then let the\n  # agent reach it at 127.0.0.1:<port from /workspace/port.txt>.\n  /opt/alva/ac_client.py serve \\\n    --alva /usr/local/bin/alva \\\n    --project /workspace/alva.toml \\\n    --port 0 --state /workspace &\n  for _ in $(seq 1 100); do\n    [ -f /workspace/port.txt ] && break\n    sleep 0.1\n  done\n  if [ ! -f /workspace/port.txt ]; then\n    echo \"FATAL: AEP gateway failed to start (no /workspace/port.txt)\" >&2\n    exit 1\n  fi\nfi\n\nif [ -f /workspace/prompt.txt ]; then\n  # Robust path: read the prompt from a file via stdin (avoids any\n  # multi-layer shell quoting of multi-word prompts).\n  cat /workspace/prompt.txt | exec codex exec \"${ARGS[@]}\" -\nelse\n  exec codex exec \"${ARGS[@]}\" \"$@\"\nfi\n","exit_code":0,"status":"completed"}}
