{"type":"item.started","item":{"id":"item_426","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\ndata = open('/usr/local/bin/alva','rb').read()\n# Let me find ALL tool names in the cmd_agent dispatcher by scanning for the pattern:\n# mov rdx/rax, imm64 (ASCII tool name chunk); ...; je handler\n# The pattern is: 48 BA <8 bytes> (mov rdx, imm) or 48 B8 <8 bytes> (mov rax, imm)\n# followed by 48 31 D0 (xor rax, rdx), 8B 49 08 (mov ecx, [rax+8]), 48 81 F1 <4 bytes> (xor rcx, imm), 48 09 C1 (or rax, rcx), 0F 84 (je)\nimport struct\nregion_start = 0xf3280\nregion_end = 0xf3e80\nnames = []\ni = region_start\nwhile i < region_end - 30:\n    # look for mov rdx, imm64 (48 BA) with ASCII\n    if data[i:i+2] == b'\\\\x48\\\\xba':\n        imm = data[i+2:i+10]\n        if all(32 <= b < 127 or b == 0 for b in imm):\n            j = i + 10\n            if data[j:j+3] == b'\\\\x48\\\\x31\\\\xd0' and data[j+3:j+6] == b'\\\\x8b\\\\x49\\\\x08' and data[j+6:j+9] == b'\\\\x48\\\\x81\\\\xf1':\n                suffix = data[j+9:j+13]\n                if data[j+13:j+16] == b'\\\\x48\\\\x09\\\\xc1' and data[j+16:j+18] == b'\\\\x0f\\\\x84':\n                    disp = struct.unpack('<i', data[j+18:j+22])[0]\n                    target = j + 22 + disp\n                    prefix = imm.decode('latin1').rstrip('\\\\x00')\n                    suffix_s = suffix.decode('latin1').rstrip('\\\\x00')\n                    name = prefix + suffix_s\n                    names.append((name, target, i))\n                    i = j + 22\n                    continue\n    i += 1\nfor n, t, o in names:\n    print(f'{n\"'!r} handler={hex(t)} at {hex(o)}'\"')\nprint('total', len(names))\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
