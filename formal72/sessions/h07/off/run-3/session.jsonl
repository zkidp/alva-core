{"type":"item.started","item":{"id":"item_179","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\ndata = open('/usr/local/bin/alva','rb').read()\n# Find the change_field handler: after the match at 0xf3c10-0xf3c30, the jump displacement 95 1c 00 00.\n# The match instructions end around 0xf3c2c; the jump is at 0xf3c2e? Let's find the target by scanning forward for the handler that calls set_field.\n# Instead, look for xrefs to \\\"set_field: missing node\\\" and the function around it.\ni = data.find(b'set_field: missing node')\nprint('set_field missing node at', i)\n# This is an error string; the function that uses it is likely nearby in code. Let's find \\\"wrong value type\\\" string and its xrefs in code via RIP-relative search.\n# For a PIE, a lea rax,[rip+disp] is 48 8d 05 disp32. Search for pattern with disp that points to 154600.\nimport struct\ntarget = 154600\ncount = 0\nfor i in range(len(data)-7):\n    if data[i:i+3] == b'\\\\x48\\\\x8d\\\\x05':\n        disp = struct.unpack('<i', data[i+3:i+7])[0]\n        # rip = address of next insn. We don't know vaddr; but file offset ~ vaddr for non-PIE? Let's assume LOAD base ~ 0.\n        rip = i + 7\n        if rip + disp == target:\n            print('lea ref at file offset', i)\n            count += 1\n            if count > 20: break\nprint('count', count)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
