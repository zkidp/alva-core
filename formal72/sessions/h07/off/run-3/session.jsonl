{"type":"item.started","item":{"id":"item_400","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\ndata = open('/workspace/alva-air/gen-5.air','rb').read()\n# Parse the type node fully, including slots\nidx = data.find(b'ALVANODE1\\\\x04\\\\x00\\\\x00\\\\x00type')\npos = idx + 9\nkind_len = int.from_bytes(data[pos:pos+4],'little'); pos += 4\nkind = data[pos:pos+kind_len]; pos += kind_len\nnf = int.from_bytes(data[pos:pos+4],'little'); pos += 4\nprint('kind', kind, 'nfields', nf)\nfor _ in range(nf):\n    fl = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n    fname = data[pos:pos+fl].decode(); pos += fl\n    vt = data[pos]; pos += 1\n    if vt == 1:\n        sl = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n        print('  field', fname, '=', data[pos:pos+sl]); pos += sl\n    elif vt == 7:\n        cnt = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n        items = []\n        for j in range(cnt):\n            sl = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n            items.append(data[pos:pos+sl].decode()); pos += sl\n        print('  field', fname, '=', items)\n    elif vt == 2:\n        cnt = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n        revs = [data[pos+j*32:pos+(j+1)*32].hex() for j in range(cnt)]\n        print('  field', fname, '= revlist', revs); pos += cnt*32\n    elif vt == 0:\n        print('  field', fname, '= nil')\n    else:\n        print('  field', fname, '= tag', vt)\n        break\n# After fields, check for slots: the next bytes might be slot entries (name, revision-list)\nprint('--- after fields, bytes:', data[pos:pos+80].hex())\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
