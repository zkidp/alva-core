{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/sh -lc \"cat /opt/alva/agent_entrypoint.sh; echo '---'; cat /opt/alva/isolation_self_test.sh\"","aggregated_output":"#!/usr/bin/env bash\nset -euo pipefail\n# Container entrypoint: run the isolation self-test, then the agent.\n/opt/alva/isolation_self_test.sh\nARGS=(-C /workspace -s workspace-write --skip-git-repo-check\n  --ephemeral --json\n  -c \"model_provider=${ALVA_PROVIDER:-deepseek}\"\n  -c preferred_auth_method=apikey\n  -c forced_login_method=api\n  -m \"${CODEX_MODEL:-deepseek-v4-flash}\")\n# The container itself is the isolation boundary (no repo mount, relay-only\n# network), so codex's internal bwrap sandbox is redundant and unavailable\n# here; bypass it inside the container only.\nARGS+=(--dangerously-bypass-approvals-and-sandbox)\n\nif [ \"${MODE:-A}\" = \"C\" ]; then\n  # Start the AEP gateway inside the container (localhost only), then let the\n  # agent reach it at 127.0.0.1:<port from /workspace/port.txt>.\n  /opt/alva/ac_client.py serve \\\n    --alva /usr/local/bin/alva \\\n    --project /workspace/alva.toml \\\n    --port 0 --state /workspace &\n  for _ in $(seq 1 100); do\n    [ -f /workspace/port.txt ] && break\n    sleep 0.1\n  done\n  if [ ! -f /workspace/port.txt ]; then\n    echo \"FATAL: AEP gateway failed to start (no /workspace/port.txt)\" >&2\n    exit 1\n  fi\nfi\n\nif [ -f /workspace/prompt.txt ]; then\n  # Robust path: read the prompt from a file via stdin (avoids any\n  # multi-layer shell quoting of multi-word prompts).\n  cat /workspace/prompt.txt | exec codex exec \"${ARGS[@]}\" -\nelse\n  exec codex exec \"${ARGS[@]}\" \"$@\"\nfi\n---\n#!/usr/bin/env bash\nset -euo pipefail\nFAIL=0\n\ncheck_fail_read() {\n  if [ -r \"$1\" ]; then\n    echo \"FAIL: $1 is readable (must NOT be mounted)\"\n    FAIL=1\n  else\n    echo \"PASS: $1 not readable\"\n  fi\n}\n\ncheck_fail_write() {\n  if touch \"$1\" 2>/dev/null; then\n    echo \"FAIL: $1 is writable (must be read-only outside /workspace)\"\n    FAIL=1\n  else\n    echo \"PASS: $1 not writable\"\n  fi\n}\n\n# 1. held-out verifier / host secrets must not be mounted\ncheck_fail_read /host-secrets/marker\ncheck_fail_read /repo\n# 2. no repository mount\nif [ -d /repo ]; then\n  echo \"FAIL: /repo is present\"\n  FAIL=1\nelse\n  echo \"PASS: no /repo mount\"\nfi\n# 3. network: relay reachable, non-relay blocked (relay-only policy)\nRELAY=\"${MODEL_RELAY:-https://api.deepseek.com}\"\nRELAY_CODE=\"$(curl -s -m 8 -o /dev/null -w '%{http_code}' \"$RELAY\" 2>/dev/null || true)\"\nif [ -n \"$RELAY_CODE\" ] && [ \"$RELAY_CODE\" != \"000\" ]; then\n  echo \"PASS: relay reachable\"\nelse\n  echo \"FAIL: relay unreachable (http_code=$RELAY_CODE)\"\n  FAIL=1\nfi\nif curl -fsS -m 8 -o /dev/null https://example.com 2>/dev/null; then\n  echo \"FAIL: non-relay host reachable (network not relay-only)\"\n  FAIL=1\nelse\n  echo \"PASS: non-relay host blocked\"\nfi\n# 4. workspace writable, root read-only\nif touch /workspace/.probe 2>/dev/null && rm /workspace/.probe; then\n  echo \"PASS: /workspace writable\"\nelse\n  echo \"FAIL: /workspace not writable\"\n  FAIL=1\nfi\ncheck_fail_write /root/.probe\ncheck_fail_write /opt/alva/.probe\n\nexit $FAIL\n","exit_code":0,"status":"completed"}}
