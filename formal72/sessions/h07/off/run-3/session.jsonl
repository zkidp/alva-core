{"type":"item.started","item":{"id":"item_313","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\n# Check the committed gen-4 AIR: does the type node have variants=['pending','completed'] and fields=[type_field...]?\ndata = open('/workspace/alva-air/gen-4.air','rb').read()\nidx = data.find(b'ALVANODE1\\\\x04\\\\x00\\\\x00\\\\x00type')\npos = idx + 9\nkind_len = int.from_bytes(data[pos:pos+4],'little'); pos += 4\nkind = data[pos:pos+kind_len]; pos += kind_len\nnf = int.from_bytes(data[pos:pos+4],'little'); pos += 4\nprint('kind', kind, 'nfields', nf)\nfor _ in range(nf):\n    fl = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n    fname = data[pos:pos+fl].decode(); pos += fl\n    vt = data[pos]; pos += 1\n    if vt == 1:\n        sl = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n        print(' ', fname, '=', data[pos:pos+sl]); pos += sl\n    elif vt == 7:\n        cnt = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n        items = []\n        for j in range(cnt):\n            sl = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n            items.append(data[pos:pos+sl].decode()); pos += sl\n        print(' ', fname, '=', items)\n    elif vt == 2:\n        cnt = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n        revs = [data[pos+j*32:pos+(j+1)*32].hex() for j in range(cnt)]\n        print(' ', fname, '= revlist', revs); pos += cnt*32\n    elif vt == 0:\n        print(' ', fname, '= nil')\n    else:\n        print(' ', fname, '= tag', vt)\n        break\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
