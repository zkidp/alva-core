{"type":"item.started","item":{"id":"item_292","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\ndata = open('/workspace/alva-air/gen-3.air','rb').read()\n# Parse the type node fully to see if there are more fields after variants\nidx = data.find(b'ALVANODE1\\\\x04\\\\x00\\\\x00\\\\x00type')\npos = idx + 9\nkind_len = int.from_bytes(data[pos:pos+4],'little'); pos += 4\nkind = data[pos:pos+kind_len]; pos += kind_len\nnf = int.from_bytes(data[pos:pos+4],'little'); pos += 4\nprint('kind', kind, 'nfields', nf)\nfor _ in range(nf):\n    fl = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n    fname = data[pos:pos+fl].decode(); pos += fl\n    vt = data[pos]; pos += 1\n    print('field', fname, 'tag', vt)\n    if vt == 1:\n        sl = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n        print('  str', data[pos:pos+sl]); pos += sl\n    elif vt == 7:\n        cnt = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n        items=[]\n        for j in range(cnt):\n            sl = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n            items.append(data[pos:pos+sl].decode()); pos += sl\n        print('  list', items)\n    elif vt == 2:\n        # revision list\n        cnt = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n        revs=[]\n        for j in range(cnt):\n            revs.append(data[pos:pos+32].hex()); pos += 32\n        print('  revlist', revs)\n    elif vt == 0:\n        print('  nil')\n    else:\n        print('  ??')\n        break\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
