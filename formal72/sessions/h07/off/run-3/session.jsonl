{"type":"item.started","item":{"id":"item_136","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\ndata = open('/workspace/alva-air/h07_store.air','rb').read()\n# Find ALVANODE1 nodes and parse kind + fields roughly\nidx = 0\nnodes = []\nwhile True:\n    idx = data.find(b'ALVANODE1', idx)\n    if idx < 0: break\n    # parse: after magic, u32 kind_len, kind bytes, u32 field_count\n    pos = idx + 9\n    if pos + 4 > len(data): break\n    kind_len = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n    if pos+kind_len > len(data): break\n    kind = data[pos:pos+kind_len].decode('latin1'); pos += kind_len\n    if pos+4 > len(data): break\n    nf = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n    fields = {}\n    ok = True\n    for _ in range(nf):\n        if pos+4 > len(data): ok=False; break\n        fl = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n        fname = data[pos:pos+fl].decode('latin1'); pos += fl\n        if pos+1 > len(data): ok=False; break\n        vt = data[pos]; pos += 1\n        if vt == 1:  # string\n            if pos+4 > len(data): ok=False; break\n            sl = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n            sval = data[pos:pos+sl].decode('latin1'); pos += sl\n            fields[fname] = sval\n        elif vt == 7:  # list of strings?\n            if pos+4 > len(data): ok=False; break\n            cnt = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n            arr=[]\n            for _ in range(cnt):\n                if pos+4 > len(data): ok=False; break\n                sl = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n                sval = data[pos:pos+sl].decode('latin1'); pos += sl\n                arr.append(sval)\n            fields[fname] = arr\n        elif vt == 0:\n            # nil / no value\n            fields[fname] = None\n        else:\n            fields[fname] = f'<vt={vt}>'\n        if not ok: break\n    nodes.append((idx, kind, fields, pos))\n    idx = pos if ok else idx+9\n    if len(nodes) > 20000: break\nprint('total nodes parsed:', len(nodes))\n# find type node\nfor (off, kind, fields, pos) in nodes:\n    if kind == 'type' and fields.get('name') == 'TaskStatus':\n        print('type node:', off, fields)\n        break\n# find function nodes for encode/decode/render\nfor (off, kind, fields, pos) in nodes:\n    if kind == 'function' and fields.get('name') in ('encode_status','decode_status','render_status','main'):\n        print('fn:', fields.get('name'), fields)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
