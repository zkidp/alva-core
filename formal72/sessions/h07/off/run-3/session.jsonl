{"type":"item.started","item":{"id":"item_274","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\ndata = open('/workspace/alva-air/h07_store.air','rb').read()\n# Find the type node and dump the exact field encoding\nidx = data.find(b'ALVANODE1\\\\x04\\\\x00\\\\x00\\\\x00type')\n# parse: kind \\\"type\\\", then fields\npos = idx + 9\nkind_len = int.from_bytes(data[pos:pos+4],'little'); pos += 4\nkind = data[pos:pos+kind_len]; pos += kind_len\nnf = int.from_bytes(data[pos:pos+4],'little'); pos += 4\nprint('kind', kind, 'nfields', nf)\nfor _ in range(nf):\n    fl = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n    fname = data[pos:pos+fl].decode(); pos += fl\n    vt = data[pos]; pos += 1\n    print('field', fname, 'type tag', vt)\n    if vt == 1:\n        sl = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n        print('  str:', data[pos:pos+sl]); pos += sl\n    elif vt == 7:\n        cnt = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n        print('  list count', cnt)\n        for j in range(cnt):\n            sl = int.from_bytes(data[pos:pos+4],'little'); pos += 4\n            print('   item:', data[pos:pos+sl]); pos += sl\n    elif vt == 0:\n        print('  nil')\n    else:\n        print('  unknown vt', vt)\n        break\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
