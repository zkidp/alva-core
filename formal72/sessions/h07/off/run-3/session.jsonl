a[i+3:i+7])[0]\n        # vaddr of i: file i -> vaddr 0x8a380 + (i - 0x89380) = i + 0x1000\n        v = (i + 0x1000) + 7 + disp\n        # map vaddr to file: if in rodata (0x22d00-0x58dc8), file = vaddr\n        if 0x22d00 <= v < 0x58dc8:\n            mask = data[v:v+16]\n            print(hex(i), 'mask:', mask)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
