{"type":"item.started","item":{"id":"item_242","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\ndata = open('/usr/local/bin/alva','rb').read()\n# Find code xrefs to vaddr 0x25be8 (E_AEP_004 string). For RIP-relative lea, search for 48 8d 05/0d/15/1d/25/2d/35/3d with disp32.\nimport struct\ntarget = 0x25be8\nhits = []\nfor i in range(len(data)-7):\n    if data[i] == 0x48 and data[i+1] in (0x8d,) and data[i+2] in (0x05,0x0d,0x15,0x1d,0x25,0x2d,0x35,0x3d):\n        disp = struct.unpack('<i', data[i+3:i+7])[0]\n        # rip = address of next instruction; vaddr of file offset i is i (LOAD0 maps 0->0)\n        rip = i + 7\n        if rip + disp == target:\n            hits.append(i)\nprint('hits:', [hex(h) for h in hits[:20]], 'count', len(hits))\n# Also search for the address in a different form: movabs or rip+disp via other encodings\n# Print code around first hit\nfor h in hits[:3]:\n    print('--- around', hex(h))\n    chunk = data[h-30:h+80]\n    print(' '.join(f'{b:02x}' for b in chunk))\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
