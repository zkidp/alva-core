{"type":"item.started","item":{"id":"item_392","type":"command_execution","command":"/bin/sh -lc \"python3 - <<'EOF'\ndata = open('/usr/local/bin/alva','rb').read()\n# Reconstruct tool names from the dispatcher: each match arm does:\n#   mov rax, [rsp+0x178]      ; request object\n#   mov rax, [rax]            ; tool name string pointer\n#   mov rdx, PREFIX           ; first 8 bytes\n#   xor rax, rdx\n#   mov ecx, [rax+8]          ; bytes 8-11\n#   xor rcx, SUFFIX4          ; suffix\n#   or rax, rcx\n#   je handler\n# The prefix is an 8-byte immediate, suffix is a 4-byte immediate.\n# Let me scan the region 0xf3200-0xf3e80 for these patterns and reconstruct names.\nimport struct\nregion_start = 0xf3200\nregion_end = 0xf3e80\narms = []\ni = region_start\nwhile i < region_end - 20:\n    # look for '48 ba' (mov rdx, imm64) followed by 8 bytes\n    if data[i:i+2] == b'\\\\x48\\\\xba':\n        imm8 = data[i+2:i+10]\n        j = i + 10\n        # look for '48 31 d0' (xor rax, rdx)\n        if data[j:j+3] == b'\\\\x48\\\\x31\\\\xd0':\n            j += 3\n            # '8b 49 08' (mov ecx, [rax+8])\n            if data[j:j+3] == b'\\\\x8b\\\\x49\\\\x08':\n                j += 3\n                # '48 81 f1' (xor rcx, imm32)\n                if data[j:j+3] == b'\\\\x48\\\\x81\\\\xf1':\n                    imm4 = data[j+3:j+7]\n                    j += 7\n                    # '48 09 c1' (or rax, rcx)\n                    if data[j:j+3] == b'\\\\x48\\\\x09\\\\xc1':\n                        j += 3\n                        # '0f 84' (je)\n                        if data[j:j+2] == b'\\\\x0f\\\\x84':\n                            disp = struct.unpack('<i', data[j+2:j+6])[0]\n                            target = j + 6 + disp\n                            prefix = imm8.decode('latin1')\n                            suffix = imm4.decode('latin1')\n                            name = (prefix + suffix).rstrip('\\\\x00')\n                            arms.append((i, target, name))\n        i = j\n    else:\n        i += 1\nfor a, t, n in arms:\n    print(f'{hex(a)} -> {hex(t)}  {n}')\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
