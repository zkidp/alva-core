{"type":"item.completed","item":{"id":"item_514","type":"command_execution","command":"/bin/sh -lc \"sed -n '20,110p' /workspace/out/h01/src/h01_sel.rs\"","aggregated_output":"}\n\nfn better(a: Item, b: Item) -> bool {\n    if (a.clone().priority.clone() == b.clone().priority.clone()) { a.clone().seq.clone() < b.clone().seq.clone() } else { a.clone().priority.clone() > b.clone().priority.clone() }\n}\n\npub fn select_best(items: Vec<Item>, min_qty: i64, policy: String) -> Result<Item, String> {\n    { let mut __acc1: Result<Item, String> = Err(\"E_H01_NO_ELIGIBLE\".to_string()); for __i0 in 0i64..(items.clone().len() as i64) { __acc1 = { let it = items.clone()[(__i0.clone()) as usize].clone(); if (eligible(it.clone(), min_qty.clone())) { if __acc1.clone().is_ok() { { let cur = __acc1.clone().expect(\"[alva] unwrap on Err\"); if (policy.clone() == \"priority\".to_string()) { if (better(it.clone(), cur.clone())) { Ok(it.clone()) } else { __acc1.clone() } } else { if (policy.clone() == \"qty\".to_string()) { if (it.clone().qty.clone() > cur.clone().qty.clone()) { Ok(it.clone()) } else { __acc1.clone() } } else { if (policy.clone() == \"first\".to_string()) { __acc1.clone() } else { Err(format!(\"{}{}\", \"E_H01_POLICY: \".to_string(), policy.clone())) } } } } } else { if (policy.clone() == \"priority\".to_string()) { Ok(it.clone()) } else { if (policy.clone() == \"qty\".to_string()) { Ok(it.clone()) } else { if (policy.clone() == \"first\".to_string()) { Ok(it.clone()) } else { Err(format!(\"{}{}\", \"E_H01_POLICY: \".to_string(), policy.clone())) } } } } } else { __acc1.clone() } }; } __acc1 }\n}\n\npub fn pick_for_shipment(items: Vec<Item>, min_qty: i64, policy: String) -> Result<Item, String> {\n    select_best(items.clone(), min_qty.clone(), policy.clone())\n}\n\npub fn report_selected(items: Vec<Item>, min_qty: i64, policy: String) -> String {\n    { let r = select_best(items.clone(), min_qty.clone(), policy.clone()); if r.clone().is_ok() { (r.clone().expect(\"[alva] unwrap on Err\")).id.clone() } else { \"none\".to_string() } }\n}\n\nfn mk_item(id: String, qty: i64, prio: i64, n: i64) -> Item {\n    Item { id: id.clone(), qty: qty.clone(), priority: prio.clone(), seq: n.clone() }\n}\n\nfn base_items() -> Vec<Item> {\n    vec![mk_item(\"a\".to_string(), 5i64, 1i64, 1i64), mk_item(\"b\".to_string(), 3i64, 2i64, 2i64), mk_item(\"c\".to_string(), 0i64, 9i64, 3i64)]\n}\n\nfn tie_items() -> Vec<Item> {\n    vec![mk_item(\"x\".to_string(), 4i64, 7i64, 1i64), mk_item(\"y\".to_string(), 4i64, 7i64, 2i64)]\n}\n\nfn sc_priority(policy: String) -> Result<(), String> {\n    { let r = select_best(base_items(), 1i64, policy.clone()); if r.clone().is_ok() { { { println!(\"{}\", format!(\"{}{}\", \"SELECTED=\".to_string(), (r.clone().expect(\"[alva] unwrap on Err\")).id.clone())); }; Ok(()) } } else { { { println!(\"{}\", { match r.clone() { Ok(__v) => panic!(\"[alva] err-value on Ok\"), Err(__e) => __e } }); }; Ok(()) } } }\n}\n\nfn sc_tie(policy: String) -> Result<(), String> {\n    { let r = select_best(tie_items(), 1i64, policy.clone()); if r.clone().is_ok() { { { println!(\"{}\", format!(\"{}{}\", \"SELECTED=\".to_string(), (r.clone().expect(\"[alva] unwrap on Err\")).id.clone())); }; Ok(()) } } else { { { println!(\"{}\", { match r.clone() { Ok(__v) => panic!(\"[alva] err-value on Ok\"), Err(__e) => __e } }); }; Ok(()) } } }\n}\n\nfn sc_no_eligible(policy: String) -> Result<(), String> {\n    { let r = select_best(base_items(), 99i64, policy.clone()); if r.clone().is_ok() { { { println!(\"{}\", format!(\"{}{}\", \"SELECTED=\".to_string(), (r.clone().expect(\"[alva] unwrap on Err\")).id.clone())); }; Ok(()) } } else { { { println!(\"{}\", { match r.clone() { Ok(__v) => panic!(\"[alva] err-value on Ok\"), Err(__e) => __e } }); }; Ok(()) } } }\n}\n\nfn sc_pick(policy: String) -> Result<(), String> {\n    { let r = pick_for_shipment(base_items(), 1i64, policy.clone()); if r.clone().is_ok() { { { println!(\"{}\", format!(\"{}{}\", \"SELECTED=\".to_string(), (r.clone().expect(\"[alva] unwrap on Err\")).id.clone())); }; Ok(()) } } else { { { println!(\"{}\", { match r.clone() { Ok(__v) => panic!(\"[alva] err-value on Ok\"), Err(__e) => __e } }); }; Ok(()) } } }\n}\n\nfn sc_report(policy: String) -> Result<(), String> {\n    { { println!(\"{}\", format!(\"{}{}\", \"REPORT=\".to_string(), report_selected(base_items(), 1i64, policy.clone()))); }; Ok(()) }\n}\n\npub fn main() -> Result<(), String> {\n    { let scenario = __ext_fs_env_string(\"H01_SCENARIO\".to_string(), \"priority\".to_string()); if (scenario.clone() == \"priority\".to_string()) { sc_priority(\"priority\".to_string()) } else { if (scenario.clone() == \"tie\".to_string()) { sc_tie(\"priority\".to_string()) } else { if (scenario.clone() == \"no_eligible\".to_string()) { sc_no_eligible(\"priority\".to_string()) } else { if (scenario.clone() == \"pick\".to_string()) { sc_pick(\"priority\".to_string()) } else { if (scenario.clone() == \"report\".to_string()) { sc_report(\"priority\".to_string()) } else { if (scenario.clone() == \"qty\".to_string()) { sc_priority(\"qty\".to_string()) } else { if (scenario.clone() == \"first\".to_string()) { sc_priority(\"first\".to_string()) } else { if (scenario.clone() == \"unknown_policy\".to_string()) { sc_priority(scenario.clone()) } else { if (scenario.clone() == \"bad_policy\".to_string()) { sc_priority(scenario.clone()) } else { if (scenario.clone() == \"unknown\".to_string()) { sc_priority(scenario.clone()) } else { if (scenario.clone() == \"bogus\".to_string()) { sc_priority(scenario.clone()) } else { if (scenario.clone() == \"pick_qty\".to_string()) { sc_pick(\"qty\".to_string()) } else { if (scenario.clone() == \"report_qty\".to_string()) { sc_report(\"qty\".to_string()) } else { if (scenario.clone() == \"pick_first\".to_string()) { sc_pick(\"first\".to_string()) } else { if (scenario.clone() == \"report_first\".to_string()) { sc_report(\"first\".to_string()) } else { Err(format!(\"{}{}\", \"E_H01_UNKNOWN_SCENARIO: \".to_string(), scenario.clone())) } } } } } } } } } } } } } } } }\n}\n\n\nmod glue {\n    use std::io::{Read, Write};\n    use std::net::{TcpListener, TcpStream};\n\n    pub struct HttpRequest {\n        pub method: String,\n        pub path: String,\n        pub query: String,\n        pub headers: std::collections::HashMap<String, String>,\n        pub body: Vec<u8>,\n    }\n\n    pub fn start_server(port: i64) -> u64 {\n        let addr = format!(\"127.0.0.1:{}\", port);\n        let listener = TcpListener::bind(addr).unwrap();\n        Box::into_raw(Box::new(listener)) as u64\n    }\n\n    pub fn accept_connection(handle: u64) -> u64 {\n        let listener = unsafe { &*(handle as *const TcpListener) };\n        match listener.accept() {\n            Ok((stream, _)) => Box::into_raw(Box::new(stream)) as u64,\n            Err(_) => 0,\n        }\n    }\n\n    pub fn read_request(stream: u64) -> HttpRequest {\n        let stream = unsafe { &mut *(stream as *mut TcpStream) };\n        let mut buf = Vec::new();\n        let mut tmp = [0u8; 4096];\n        loop {\n            let n = stream.read(&mut tmp).unwrap_or(0);\n            if n == 0 {\n                break;\n            }\n            buf.extend_from_slice(&tmp[..n]);\n","exit_code":0,"status":"completed"}}
