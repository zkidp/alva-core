{"type":"item.completed","item":{"id":"item_163","type":"command_execution","command":"/bin/sh -lc 'cat /opt/alva/isolation_self_test.sh'","aggregated_output":"#!/usr/bin/env bash\nset -euo pipefail\nFAIL=0\n\ncheck_fail_read() {\n  if [ -r \"$1\" ]; then\n    echo \"FAIL: $1 is readable (must NOT be mounted)\"\n    FAIL=1\n  else\n    echo \"PASS: $1 not readable\"\n  fi\n}\n\ncheck_fail_write() {\n  if touch \"$1\" 2>/dev/null; then\n    echo \"FAIL: $1 is writable (must be read-only outside /workspace)\"\n    FAIL=1\n  else\n    echo \"PASS: $1 not writable\"\n  fi\n}\n\n# 1. held-out verifier / host secrets must not be mounted\ncheck_fail_read /host-secrets/marker\ncheck_fail_read /repo\n# 2. no repository mount\nif [ -d /repo ]; then\n  echo \"FAIL: /repo is present\"\n  FAIL=1\nelse\n  echo \"PASS: no /repo mount\"\nfi\n# 3. network: relay reachable, non-relay blocked (relay-only policy)\nRELAY=\"${MODEL_RELAY:-https://api.deepseek.com}\"\nRELAY_CODE=\"$(curl -s -m 8 -o /dev/null -w '%{http_code}' \"$RELAY\" 2>/dev/null || true)\"\nif [ -n \"$RELAY_CODE\" ] && [ \"$RELAY_CODE\" != \"000\" ]; then\n  echo \"PASS: relay reachable\"\nelse\n  echo \"FAIL: relay unreachable (http_code=$RELAY_CODE)\"\n  FAIL=1\nfi\nif curl -fsS -m 8 -o /dev/null https://example.com 2>/dev/null; then\n  echo \"FAIL: non-relay host reachable (network not relay-only)\"\n  FAIL=1\nelse\n  echo \"PASS: non-relay host blocked\"\nfi\n# 4. workspace writable, root read-only\nif touch /workspace/.probe 2>/dev/null && rm /workspace/.probe; then\n  echo \"PASS: /workspace writable\"\nelse\n  echo \"FAIL: /workspace not writable\"\n  FAIL=1\nfi\ncheck_fail_write /root/.probe\ncheck_fail_write /opt/alva/.probe\n\nexit $FAIL\n","exit_code":0,"status":"completed"}}
