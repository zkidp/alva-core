 root     root          2361 Aug 12 16:32 aep.py\n-rwxrwxr-x    1 root     root          1424 Aug 12 16:32 agent_entrypoint.sh\n-rwxrwxr-x    1 root     root          1467 Aug 12 16:32 isolation_self_test.sh\n---\nPID   USER     TIME  COMMAND\n    1 agent     0:00 bash /opt/alva/agent_entrypoint.sh\n   15 agent     0:00 python3 /opt/alva/ac_client.py serve --alva /usr/local/bin/alva --project /workspace/alva.toml --port 0 --state /workspace\n   19 agent     0:00 /usr/local/bin/alva agent\n   22 agent     0:02 codex exec -C /workspace -s workspace-write --skip-git-repo-check --ephemeral --json -c model_provider=deepseek -c preferred_auth_method=apikey -c forced_login_method=api -m deepseek-v4-flash --dangerously-bypass-approvals-and-sandbox -\n  241 agent     0:00 /bin/sh -c cat /opt/alva/agent_entrypoint.sh; echo ---; ls -la /opt/alva; echo ---; ps aux 2>/dev/null | head -30\n  244 agent     0:00 ps aux\n  245 agent     0:00 head -30\n","exit_code":0,"status":"completed"}}
