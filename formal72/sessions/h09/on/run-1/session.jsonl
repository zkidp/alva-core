{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/sh -lc 'cat /opt/alva/aep.py /opt/alva/ac_client.py'","aggregated_output":"#!/usr/bin/env python3\n\"\"\"AEP tool CLI for mode C pilots.\n\nThin wrapper over the ac_client.py gateway that takes key=value arguments\ninstead of a JSON string, so no shell quoting is needed:\n\n  python aep.py --port <port> begin_transaction project=C:\\\\path\\\\to\\\\alva.toml\n  python aep.py --port <port> create_literal type=string value=fsync_meta_dir\n  python aep.py --port <port> create_call name=step args=<literal_revision>\n  python aep.py --port <port> append_step function=store.commit.put_object step=<call_revision>\n  python aep.py --port <port> check_transaction\n  python aep.py --port <port> commit_transaction\n\nRepeatable keys:\n  args=...        -> list of call arguments (create_call)\n  params=...      -> flat list of parameter names (add_function; types default \"string\")\n\nSee AEP_TOOLS.md for the full tool list.\n\"\"\"\n\nimport argparse\nimport json\nimport socket\nimport sys\n\n\ndef call(port, request):\n    payload = (json.dumps(request, ensure_ascii=False) + \"\\n\").encode(\"utf-8\")\n    last = \"\"\n    for attempt in range(3):\n        try:\n            with socket.create_connection((\"127.0.0.1\", port), timeout=300) as s:\n                s.sendall(payload)\n                buf = b\"\"\n                while True:\n                    chunk = s.recv(1 << 20)\n                    if not chunk:\n                        break\n                    buf += chunk\n                    if buf.endswith(b\"\\n\"):\n                        break\n            last = buf.decode(\"utf-8\").strip()\n            if last:\n                break\n        except OSError:\n            last = \"\"\n        if not last and attempt < 2:\n            import time\n            time.sleep(0.5)\n    print(last or '{\"ok\":false,\"result\":null,\"message\":\"empty gateway response\"}')\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__)\n    ap.add_argument(\"--port\", type=int, required=True)\n    ap.add_argument(\"tool\")\n    ap.add_argument(\"kv\", nargs=\"*\", help=\"key=value arguments\")\n    args = ap.parse_args()\n    req = {\"tool\": args.tool}\n    for item in args.kv:\n        if \"=\" not in item:\n            sys.exit(\"expected key=value, got: \" + item)\n        k, v = item.split(\"=\", 1)\n        if k in (\"args\", \"params\"):\n            req.setdefault(k, []).append(v)\n        else:\n            req[k] = v\n    call(args.port, req)\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n#!/usr/bin/env python3\n\"\"\"AEP tool gateway for mode C pilot runs.\n\nThe Agent Runtime (`alva agent`) is a persistent stdin/stdout session. This\ngateway keeps that session alive in a background process and exposes one-shot\ntool calls over a local TCP socket, so an external agent can call AEP tools\none at a time:\n\n  python ac_client.py serve --alva <exe> --project <toml> --port <n> --state <dir>\n      spawns `alva agent`, listens on 127.0.0.1:<n>, writes the actual port to\n      <dir>/port.txt (use --port 0 to pick a free port)\n  python ac_client.py call --port <n> --request '<json>'\n      sends one tool request, prints the response JSON on one line\n  python ac_client.py stop --port <n>\n      tells the server to terminate the agent session and exit\n\nEvery call is a full AEP request: {\"request_id\": \"...\", \"tool\": \"...\", ...}.\n\"\"\"\n\nimport argparse\nimport json\nimport os\nimport socket\nimport subprocess\nimport sys\nimport threading\nimport time\n\n\ndef serve(alva, project, port, state_dir):\n    agent = subprocess.Popen(\n        [alva, \"agent\"],\n        stdin=subprocess.PIPE,\n        stdout=subprocess.PIPE,\n        text=True,\n        bufsize=1,\n    )\n    lock = threading.Lock()\n    stopped = {\"v\": False}\n\n    def read_response():\n        line = agent.stdout.readline()\n        if not line:\n            return None\n        return line.strip()\n\n    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\n    srv.bind((\"127.0.0.1\", port))\n    srv.listen(16)\n    actual_port = srv.getsockname()[1]\n    os.makedirs(state_dir, exist_ok=True)\n    with open(os.path.join(state_dir, \"port.txt\"), \"w\", encoding=\"utf-8\") as fh:\n        fh.write(str(actual_port) + \"\\n\")\n    with open(os.path.join(state_dir, \"pid.txt\"), \"w\", encoding=\"utf-8\") as fh:\n        fh.write(str(os.getpid()) + \"\\n\")\n\n    def serve_loop():\n        while not stopped[\"v\"]:\n            try:\n                conn, _ = srv.accept()\n            except OSError:\n                break\n            with conn:\n                data = b\"\"\n                while True:\n                    chunk = conn.recv(1 << 20)\n                    if not chunk:\n                        break\n                    data += chunk\n                    if data.endswith(b\"\\n\"):\n                        break\n                if not data:\n                    continue\n                req = data.decode(\"utf-8\").strip()\n                if req == '{\"control\":\"stop\"}':\n                    stopped[\"v\"] = True\n                    conn.sendall(b'{\"control\":\"stopped\"}\\n')\n                    break\n                with lock:\n                    agent.stdin.write(req + \"\\n\")\n                    agent.stdin.flush()\n                    resp = read_response()\n                if resp is None:\n                    resp = json.dumps(\n                        {\"ok\": False, \"result\": \"null\",\n                         \"message\": \"agent process exited unexpectedly\"}\n                    )\n                conn.sendall((resp + \"\\n\").encode(\"utf-8\"))\n        srv.close()\n\n    th = threading.Thread(target=serve_loop, daemon=True)\n    th.start()\n    try:\n        while th.is_alive():\n            time.sleep(0.2)\n    except KeyboardInterrupt:\n        pass\n    stopped[\"v\"] = True\n    try:\n        srv.close()\n    except OSError:\n        pass\n    try:\n        agent.stdin.close()\n    except Exception:\n        pass\n    try:\n        agent.terminate()\n    except Exception:\n        pass\n    try:\n        agent.wait(timeout=5)\n    except Exception:\n        agent.kill()\n    return 0\n\n\ndef call(port, request):\n    payload = (request if request.endswith(\"\\n\") else request + \"\\n\").encode(\"utf-8\")\n    with socket.create_connection((\"127.0.0.1\", port), timeout=120) as s:\n        s.sendall(payload)\n        buf = b\"\"\n        while True:\n            chunk = s.recv(1 << 20)\n            if not chunk:\n                break\n            buf += chunk\n            if buf.endswith(b\"\\n\"):\n                break\n    print(buf.decode(\"utf-8\").strip())\n    return 0\n\n\ndef stop(port):\n    try:\n        with socket.create_connection((\"127.0.0.1\", port), timeout=10) as s:\n            s.sendall(b'{\"control\":\"stop\"}\\n')\n            s.recv(1024)\n    except OSError:\n        pass\n    return 0\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__)\n    sub = ap.add_subparsers(dest=\"cmd\", required=True)\n    p_serve = sub.add_parser(\"serve\")\n    p_serve.add_argument(\"--alva\", required=True)\n    p_serve.add_argument(\"--project\", required=True)\n    p_serve.add_argument(\"--port\", type=int, default=0)\n    p_serve.add_argument(\"--state\", required=True)\n    p_call = sub.add_parser(\"call\")\n    p_call.add_argument(\"--port\", type=int, required=True)\n    p_call.add_argument(\"--request\", required=True)\n    p_stop = sub.add_parser(\"stop\")\n    p_stop.add_argument(\"--port\", type=int, required=True)\n    args = ap.parse_args()\n    if args.cmd == \"serve\":\n        return serve(args.alva, args.project, args.port, args.state)\n    if args.cmd == \"call\":\n        return call(args.port, args.request)\n    if args.cmd == \"stop\":\n        return stop(args.port)\n    return 2\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","exit_code":0,"status":"completed"}}
